{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/vercel-build.mjs",
  "git": {
    "deploymentEnabled": {
      "release/puragenda-next-rc1": false,
      "fix/puragenda-next-audit-01-registration": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/mcp-cleanup",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/tracking-retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/trial-expiry",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/payment-holds",
      "schedule": "30 4 * * *"
    }
  ]
}
