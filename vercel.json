{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/vercel-build.mjs",
  "crons": [
    {
      "path": "/api/cron/tracking-retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/trial-expiry",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "0 14 * * *"
    }
  ]
}
