{
  "name": "agenda",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:payments": "node scripts/dev-payment-simulator.mjs",
    "qa:payments:db": "node scripts/dev-payment-simulator.mjs --prepare-only",
    "dev:turbo": "next dev --turbopack -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:payments:local": "vitest run tests/server/local-payment-simulator.service.test.ts tests/server/local-payment-simulator.route.test.ts tests/server/international-subscription-simulator.route.test.ts tests/server/mercadopago-oauth.service.test.ts tests/server/mercadopago-deposit.route.test.ts tests/server/mercadopago-deposit-return.route.test.ts tests/server/mercadopago-deposit-webhook.route.test.ts",
    "test:watch": "vitest",
    "db:migrate:deploy": "prisma migrate deploy",
    "seed": "npx prisma db seed",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "esbuild": "0.28.1",
    "eslint-config-next": {
      "brace-expansion": "5.0.8",
      "minimatch": "10.2.4"
    },
    "find-my-way": "9.7.0",
    "postcss": "8.5.23",
    "sharp": "0.35.0",
    "valibot": "1.4.2"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "driver.js": "^1.4.0",
    "lucide-react": "^1.8.0",
    "mercadopago": "^3.2.1",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.12",
    "prisma": "^7.9.0",
    "shadcn": "^4.15.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
