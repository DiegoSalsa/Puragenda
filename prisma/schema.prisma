generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// AUTH & USERS
// ==========================================

enum UserRole {
  ADMIN
  RECEPTIONIST
  STAFF
  SUPERADMIN
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  password         String
  name             String
  role             UserRole  @default(ADMIN)
  isSuperAdmin     Boolean   @default(false)
  trialUsedAt      DateTime?
  registrationIp   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  businesses Business[]
  staff      Staff[]
}

// ==========================================
// PASSWORD RESET
// ==========================================

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// ==========================================
// ANTI-FRAUD
// ==========================================

model BlacklistedIp {
  id        String   @id @default(cuid())
  ip        String   @unique
  reason    String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([ip])
}

// ==========================================
// SUBSCRIPTIONS
// ==========================================

enum SubscriptionPlan {
  INDIVIDUAL
  BASIC
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  INACTIVE
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

model Subscription {
  id                    String             @id @default(cuid())
  plan                  SubscriptionPlan   @default(INDIVIDUAL)
  status                SubscriptionStatus @default(ACTIVE)
  billingCycle          BillingCycle       @default(MONTHLY)
  isTrial               Boolean            @default(false)
  trialEndsAt           DateTime?
  extraStaffCount       Int                @default(0)
  nextBillingDiscount   Float              @default(0)
  businessId            String             @unique
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  currentPeriodEnd      DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ==========================================
// BUSINESS & SERVICES
// ==========================================

model Business {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String   @unique
  apiKey                String   @unique
  logoUrl               String?
  primaryColor          String   @default("#7C3AED")
  secondaryColor        String   @default("#5B21B6")
  backgroundColor       String   @default("#0A0A0A")
  textColor             String   @default("#FFFFFF")
  textMutedColor        String   @default("#FFFFFF66")
  widgetFontSize        Int      @default(14)
  brandColor            String?
  maxServicesPerBooking Int      @default(1)
  allowedOrigins        String[] @default([])
  timezone              String   @default("America/Santiago")
  ownerId               String?
  referredByAffiliateId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  owner              User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  referredByAffiliate Affiliate?    @relation("ReferredBy", fields: [referredByAffiliateId], references: [id], onDelete: SetNull)
  affiliate          Affiliate?     @relation("AffiliateOwner")
  services           Service[]
  staff              Staff[]
  appointments       Appointment[]
  clients            Client[]
  subscription       Subscription?
  businessHours      BusinessHours[]
  blockedDates       BlockedDate[]

  @@index([ownerId])
  @@index([referredByAffiliateId])
}

model BusinessHours {
  id         String  @id @default(cuid())
  dayOfWeek  Int
  startTime  String
  endTime    String
  isOpen     Boolean @default(true)
  businessId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

model BlockedDate {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  reason     String?
  businessId String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
  @@index([businessId])
}

model Staff {
  id         String   @id @default(cuid())
  name       String
  email      String?
  businessId String
  userId     String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments  Appointment[]
  schedule      StaffSchedule[]

  @@unique([businessId, email])
  @@index([businessId])
}

model StaffSchedule {
  id        String  @id @default(cuid())
  dayOfWeek Int
  startTime String
  endTime   String
  isWorking Boolean @default(true)
  staffId   String

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@index([staffId])
}

model Service {
  id          String  @id @default(cuid())
  name        String
  description String?
  duration    Int
  price       Float
  businessId  String

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([businessId])
}

// ==========================================
// APPOINTMENTS
// ==========================================

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  CHECKED_IN
  NO_SHOW
}

model Appointment {
  id                   String            @id @default(cuid())
  customerName         String
  customerEmail        String
  customerPhone        String?
  startTime            DateTime
  endTime              DateTime
  status               AppointmentStatus @default(PENDING)
  additionalServiceIds String[]          @default([])
  totalDuration        Int?
  totalPrice           Float?
  businessId           String
  serviceId            String
  staffId              String?
  clientId             String?
  createdAt            DateTime          @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff    Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  client   Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([serviceId])
  @@index([staffId, startTime, endTime])
  @@index([startTime])
  @@index([clientId])
}

// ==========================================
// CRM — CLIENTS
// ==========================================

model Client {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String?
  totalSpent   Float    @default(0)
  noShowCount  Int      @default(0)
  businessId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([businessId, email])
  @@index([businessId])
}

// ==========================================
// AFFILIATES
// ==========================================

model Affiliate {
  id                 String     @id @default(cuid())
  referralCode       String     @unique
  businessId         String     @unique
  paidReferrals      Int        @default(0)
  createdAt          DateTime   @default(now())

  business           Business   @relation("AffiliateOwner", fields: [businessId], references: [id], onDelete: Cascade)
  referredBusinesses Business[] @relation("ReferredBy")

  @@index([referralCode])
}
