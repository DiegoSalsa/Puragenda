generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// AUTH & USERS
// ==========================================

enum UserRole {
  ADMIN
  RECEPTIONIST
  STAFF
  SUPERADMIN
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  name            String
  role            UserRole  @default(ADMIN)
  isSuperAdmin    Boolean   @default(false)
  trialUsedAt     DateTime?
  registrationIp  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tokenVersion    Int       @default(1)
  deletedAt       DateTime?
  termsAcceptedAt DateTime?

  businesses                Business[]
  staff                     Staff[]
  auditLogs                 AuditLog[]
  adminLoginCodes           AdminLoginCode[]
  platformDiscountCodes     PlatformDiscountCode[]     @relation("PlatformDiscountCreatedBy")
  adminInteractiveCampaigns AdminInteractiveCampaign[] @relation("AdminInteractiveCampaignCreatedBy")
}

// ==========================================
// PASSWORD RESET
// ==========================================

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model AdminLoginCode {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// ==========================================
// ANTI-FRAUD
// ==========================================

model BlacklistedIp {
  id        String   @id @default(cuid())
  ip        String   @unique
  reason    String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([ip])
}

// ==========================================
// SUBSCRIPTIONS
// ==========================================

enum SubscriptionPlan {
  INDIVIDUAL
  EQUIPO
  TEST
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  INACTIVE
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum RecurringMode {
  FIXED_DAYS // El negocio fija exactamente que dias (ej: L/M/V)
  DAYS_WITH_REST // N dias/semana con minimo de descanso entre sesiones
  FREE_MINIMUM // Libre con minimo de dias semanales, cliente elige
}

enum RecurringStatus {
  PENDING_APPROVAL // Esperando que el negocio apruebe
  ACTIVE // Corriendo normalmente
  PAUSED // Pausada temporalmente
  CANCELLED // Cancelada por el negocio o el cliente
  COMPLETED // Termino el periodo natural
}

model Subscription {
  id                           String             @id @default(cuid())
  plan                         SubscriptionPlan   @default(INDIVIDUAL)
  status                       SubscriptionStatus @default(ACTIVE)
  billingCycle                 BillingCycle       @default(MONTHLY)
  isTrial                      Boolean            @default(false)
  trialEndsAt                  DateTime?
  extraStaffCount              Int                @default(0)
  pendingDiscountPercentage    Int?
  hasCountedAsPaidReferral     Boolean            @default(false)
  trialWarningEmailSent        Boolean            @default(false)
  freeMonthsRemaining          Int                @default(0)
  activePrizeId                String?
  promoName                    String?
  promoFreeMonthsRemaining     Int                @default(0)
  promoDiscountPercentage      Int?
  promoDiscountMonthsRemaining Int                @default(0)
  nextBillingOverrideAmount    Int?
  billingNotes                 String?
  lastBillingSyncAt            DateTime?
  lastBillingSyncError         String?
  businessId                   String             @unique
  mpCustomerId                 String?
  mpSubscriptionId             String?
  currentPeriodEnd             DateTime?
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt

  business                    Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platformDiscountRedemptions PlatformDiscountRedemption[]
}

// ==========================================
// BUSINESS & SERVICES
// ==========================================

model Business {
  id                       String    @id @default(cuid())
  name                     String
  slug                     String    @unique
  apiKey                   String    @unique
  logoUrl                  String?
  address                  String?
  mapsUrl                  String?
  primaryColor             String    @default("#7C3AED")
  secondaryColor           String    @default("#5B21B6")
  backgroundColor          String    @default("#0A0A0A")
  textColor                String    @default("#FFFFFF")
  textMutedColor           String    @default("#FFFFFF66")
  widgetFontSize           Int       @default(14)
  brandColor               String?
  maxServicesPerBooking    Int       @default(1)
  groupServicesByCategory  Boolean   @default(false)
  // ── Abono (Deposit) Config ──
  depositRequired          Boolean   @default(false)
  allowedOrigins           String[]  @default([])
  timezone                 String    @default("America/Santiago")
  ownerId                  String?
  referredByAffiliateId    String?
  // ── Mercado Pago OAuth (Marketplace) ──
  mpAccessToken            String?
  mpRefreshToken           String?
  mpUserId                 String?
  mpTokenExpiresAt         DateTime?
  // ── Loyalty / Fidelización ──
  isLoyaltyEnabled         Boolean   @default(false)
  stampsRequired           Int       @default(5)
  rewardName               String?
  discountType             String? // 'PERCENTAGE' | 'FIXED'
  discountValue            Int?
  // ── Politicas del negocio ──
  requiresClientRut        Boolean   @default(false) // Pedir RUT en el widget
  allowRescheduling        Boolean   @default(false) // Permitir que clientes reagenden
  rescheduleHoursLimit     Int       @default(24) // Horas minimas de anticipacion para reagendar
  // ── Configuración de agenda ──
  allowSameDayBookings     Boolean   @default(false) // Permite agendar para hoy
  slotInterval             Int       @default(60) // Minutos entre cada bloque de hora disponible
  minAdvanceBookingMinutes Int       @default(120) // Minutos de anticipación (solo si allowSameDayBookings=true)
  productionOrdersEnabled  Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  owner                       User?                        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  referredByAffiliate         Affiliate?                   @relation("ReferredBy", fields: [referredByAffiliateId], references: [id], onDelete: SetNull)
  affiliate                   Affiliate?                   @relation("AffiliateOwner")
  services                    Service[]
  serviceCategories           ServiceCategory[]
  staff                       Staff[]
  appointments                Appointment[]
  clients                     Client[]
  subscription                Subscription?
  businessHours               BusinessHours[]
  blockedDates                BlockedDate[]
  loyaltyCodes                LoyaltyCode[]
  marketingCampaigns          MarketingCampaign[]
  recurringBookings           RecurringBooking[]
  productionOrders            ProductionOrder[]
  platformDiscountRedemptions PlatformDiscountRedemption[]

  @@index([ownerId])
  @@index([referredByAffiliateId])
}

// ==========================================
// PLATFORM DISCOUNT CODES
// ==========================================

model PlatformDiscountCode {
  id             String    @id @default(cuid())
  code           String    @unique
  name           String
  discountType   String // 'PERCENTAGE' | 'FIXED'
  discountValue  Int
  maxRedemptions Int?
  redeemedCount  Int       @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  appliesToPlans String[]  @default([])
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  createdBy   User?                        @relation("PlatformDiscountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  redemptions PlatformDiscountRedemption[]

  @@index([isActive])
  @@index([expiresAt])
}

model PlatformDiscountRedemption {
  id               String    @id @default(cuid())
  discountCodeId   String
  businessId       String
  subscriptionId   String?
  status           String    @default("PENDING") // 'PENDING' | 'APPLIED'
  originalAmount   Int
  discountedAmount Int
  createdAt        DateTime  @default(now())
  appliedAt        DateTime?

  discountCode PlatformDiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([discountCodeId, businessId])
  @@index([businessId])
  @@index([subscriptionId])
  @@index([status])
}

// ==========================================
// SUPERADMIN INTERACTIVE EMAILS
// ==========================================

model AdminInteractiveCampaign {
  id          String   @id @default(cuid())
  title       String
  type        String // 'SATISFACTION' | 'FORM'
  question    String
  fields      Json?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy  User?                       @relation("AdminInteractiveCampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  recipients AdminInteractiveRecipient[]
  responses  AdminInteractiveResponse[]

  @@index([type])
  @@index([createdAt])
}

model AdminInteractiveRecipient {
  id           String    @id @default(cuid())
  campaignId   String
  email        String
  name         String
  businessName String?
  businessSlug String?
  token        String    @unique
  createdAt    DateTime  @default(now())
  respondedAt  DateTime?

  campaign AdminInteractiveCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  response AdminInteractiveResponse?

  @@index([campaignId])
  @@index([email])
}

model AdminInteractiveResponse {
  id          String   @id @default(cuid())
  campaignId  String
  recipientId String   @unique
  rating      Int?
  answers     Json?
  comment     String?
  createdAt   DateTime @default(now())

  campaign  AdminInteractiveCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient AdminInteractiveRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([createdAt])
}

model BusinessHours {
  id         String  @id @default(cuid())
  dayOfWeek  Int
  startTime  String
  endTime    String
  isOpen     Boolean @default(true)
  businessId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

model BlockedDate {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  reason     String?
  businessId String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
  @@index([businessId])
}

model Staff {
  id         String   @id @default(cuid())
  name       String
  email      String?
  imageUrl   String?
  businessId String
  userId     String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments      Appointment[]
  schedule          StaffSchedule[]
  scheduleBlocks    ScheduleBlock[]
  services          Service[]
  recurringBookings RecurringBooking[]

  @@unique([businessId, email])
  @@index([businessId])
}

model StaffSchedule {
  id        String  @id @default(cuid())
  dayOfWeek Int
  startTime String
  endTime   String
  isWorking Boolean @default(true)
  staffId   String

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@index([staffId])
}

model ScheduleBlock {
  id        String   @id @default(cuid())
  staffId   String
  startTime DateTime
  endTime   DateTime
  reason    String?
  createdAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([staffId, startTime, endTime])
}

model Service {
  id                       String                 @id @default(cuid())
  name                     String
  description              String?
  imageUrl                 String?
  duration                 Int
  price                    Float
  depositAmount            Int                    @default(0) // CLP amount for per-service deposit
  bookingMode              ServiceBookingMode     @default(APPOINTMENT)
  productionScheduleMode   ProductionScheduleMode @default(WEEKLY)
  weeklyProductionCapacity Int                    @default(5)
  productionWeeksAhead     Int                    @default(24)
  productionLeadTimeWeeks  Int                    @default(1)
  customProductionWindows  Json?
  productionDepositPercent Int                    @default(50)
  requiresReferenceImages  Boolean                @default(false)
  businessId               String
  categoryId               String?

  business          Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category          ServiceCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  appointments      Appointment[]
  staff             Staff[]
  recurringPlan     RecurringPlan?
  recurringBookings RecurringBooking[]
  optionCategories  ServiceOptionCategory[]
  productionOrders  ProductionOrder[]

  @@index([businessId])
  @@index([categoryId])
}

model ServiceCategory {
  id         String   @id @default(cuid())
  name       String
  position   Int      @default(0)
  businessId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([businessId, name])
  @@index([businessId, position])
}

enum ServiceBookingMode {
  APPOINTMENT
  PRODUCTION
}

enum ProductionScheduleMode {
  WEEKLY
  CUSTOM
}

enum ProductionOrderStatus {
  AWAITING_DEPOSIT
  REFERENCES_REVIEW
  QUEUED
  IN_PRODUCTION
  QUALITY_CHECK
  BALANCE_DUE
  READY_TO_SHIP
  SHIPPED
  COMPLETED
  CANCELLED
}

model ProductionOrder {
  id                    String                @id @default(cuid())
  orderNumber           String                @unique
  businessId            String
  serviceId             String
  clientId              String?
  customerName          String
  customerEmail         String
  customerPhone         String
  petName               String
  petDetails            String
  referenceImageUrls    String[]              @default([])
  productionWeek        DateTime              @db.Date
  productionWindowKey   String?
  productionWindowLabel String?
  productionWindowEnd   DateTime?             @db.Date
  selectedOptions       Json?
  totalPrice            Float
  depositAmount         Int
  balanceAmount         Int
  depositPaymentStatus  PaymentStatus         @default(PENDING)
  balancePaymentStatus  PaymentStatus         @default(NONE)
  depositMpPreferenceId String?
  depositMpPaymentId    String?
  balanceMpPreferenceId String?
  balanceMpPaymentId    String?
  deliveryMethod        String                @default("COORDINATE")
  customerAddress       String?
  status                ProductionOrderStatus @default(AWAITING_DEPOSIT)
  internalNotes         String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  client   Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([serviceId, productionWeek])
  @@index([serviceId, productionWindowKey])
  @@index([clientId])
  @@index([businessId, productionWeek])
  @@index([depositMpPreferenceId])
}

model ServiceOptionCategory {
  id            String   @id @default(cuid())
  name          String
  isRequired    Boolean  @default(false)
  maxSelections Int      @default(1)
  position      Int      @default(0)
  serviceId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  service      Service                    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  alternatives ServiceOptionAlternative[]

  @@index([serviceId])
  @@index([serviceId, position])
}

model ServiceOptionAlternative {
  id            String   @id @default(cuid())
  name          String
  priceDelta    Float    @default(0)
  durationDelta Int      @default(0)
  isHomeService Boolean  @default(false)
  position      Int      @default(0)
  categoryId    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category ServiceOptionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([categoryId, position])
}

// ==========================================
// RECURRING BOOKINGS
// ==========================================

model RecurringPlan {
  id                    String        @id @default(cuid())
  serviceId             String        @unique
  mode                  RecurringMode @default(FIXED_DAYS)
  // FIXED_DAYS: dias exactos de la semana (0=Dom, 1=Lun, ... 6=Sab)
  fixedDays             Int[]         @default([])
  // DAYS_WITH_REST / FREE_MINIMUM
  daysPerWeek           Int? // cuantos dias por semana
  minRestDays           Int? // minimo dias de descanso entre sesiones
  // Opciones de duracion que el cliente puede elegir (en meses, ej: [1,2,3])
  durationOptions       Int[]         @default([1])
  // Rango maximo de dias desde hoy que el cliente puede elegir como fecha de inicio
  startDateRangeDays    Int           @default(14)
  // Aprobacion manual del negocio antes de activar
  requiresApproval      Boolean       @default(false)
  // Formulario de salud/condiciones
  requiresHealthForm    Boolean       @default(false)
  healthQuestions       String[]      @default([])
  // Pedir RUT al cliente
  requiresRut           Boolean       @default(false)
  // Mensaje personalizado para el email de renovacion
  renewalMessage        String?
  // Dias antes del vencimiento para avisar al cliente
  expirationWarningDays Int           @default(7)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  service           Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  recurringBookings RecurringBooking[]

  @@index([serviceId])
}

model RecurringBooking {
  id                    String          @id @default(cuid())
  businessId            String
  serviceId             String
  recurringPlanId       String
  staffId               String?
  clientId              String?
  customerName          String
  customerEmail         String
  customerPhone         String?
  customerAddress       String?
  customerRut           String?
  status                RecurringStatus @default(PENDING_APPROVAL)
  // Dias elegidos por el cliente (0=Dom, 1=Lun, ... 6=Sab)
  selectedDays          Int[]
  // Hora por dia: JSON { "1": "08:00", "3": "10:00", "5": "09:00" }
  selectedTimes         Json
  startDate             DateTime
  endDate               DateTime
  durationMonths        Int
  // Formulario de salud
  healthAnswers         Json? // Respuestas a healthQuestions
  healthFreeText        String? // Texto libre del cliente
  healthAccepted        Boolean         @default(false) // Acepto que pueden rechazar
  // Estado de pausa
  pausedUntil           DateTime?
  // Notas internas del negocio (solo lo ve el negocio)
  internalNotes         String?
  // Control de emails automaticos ya enviados
  expirationWarningSent Boolean         @default(false)
  renewalOffered        Boolean         @default(false)
  // Token para el link de gestion del cliente (/mi-plan/[token])
  managementToken       String?         @unique
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  business         Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service          Service                    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  recurringPlan    RecurringPlan              @relation(fields: [recurringPlanId], references: [id], onDelete: Cascade)
  staff            Staff?                     @relation(fields: [staffId], references: [id], onDelete: SetNull)
  client           Client?                    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  appointments     Appointment[]
  sessionOverrides RecurringSessionOverride[]

  @@index([businessId])
  @@index([serviceId])
  @@index([staffId])
  @@index([clientId])
  @@index([status])
  @@index([businessId, status])
}

model RecurringSessionOverride {
  id                 String   @id @default(cuid())
  recurringBookingId String
  // Fecha original del turno que se modifica
  originalDate       DateTime
  // CANCELLED o TIME_CHANGED
  action             String
  // Si es TIME_CHANGED, la nueva hora ("10:00")
  newTime            String?
  reason             String?
  requestedByClient  Boolean  @default(false)
  // Control de email de aviso enviado
  warningSent        Boolean  @default(false)
  createdAt          DateTime @default(now())

  recurringBooking RecurringBooking @relation(fields: [recurringBookingId], references: [id], onDelete: Cascade)

  @@index([recurringBookingId])
  @@index([originalDate])
  @@index([recurringBookingId, originalDate])
}

// ==========================================
// APPOINTMENTS
// ==========================================

enum AppointmentStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  CANCELLED
  CHECKED_IN
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model Appointment {
  id                   String            @id @default(cuid())
  customerName         String
  customerEmail        String
  customerPhone        String?
  customerAddress      String?
  startTime            DateTime
  endTime              DateTime
  status               AppointmentStatus @default(PENDING)
  additionalServiceIds String[]          @default([])
  totalDuration        Int?
  totalPrice           Float?
  selectedOptions      Json?
  businessId           String
  serviceId            String
  staffId              String?
  clientId             String?
  reminderSent         Boolean           @default(false)
  actionToken          String?           @unique
  // ── Deposit Payment ──
  depositAmount        Int? // CLP amount charged as deposit
  paymentStatus        PaymentStatus     @default(NONE)
  mpPaymentId          String? // MercadoPago payment ID
  mpPreferenceId       String? // MercadoPago preference ID
  // ── Recurring ──
  recurringBookingId   String? // FK a RecurringBooking si es parte de un plan
  createdAt            DateTime          @default(now())

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service          Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff            Staff?            @relation(fields: [staffId], references: [id], onDelete: SetNull)
  client           Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  recurringBooking RecurringBooking? @relation(fields: [recurringBookingId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([serviceId])
  @@index([staffId, startTime, endTime])
  @@index([startTime])
  @@index([clientId])
  @@index([recurringBookingId])
}

// ==========================================
// CRM Ã¢â‚¬â€ CLIENTS
// ==========================================

model Client {
  id               String   @id @default(cuid())
  name             String
  email            String
  phone            String?
  rut              String? // RUT del cliente (opcional, configurable por negocio)
  totalSpent       Float    @default(0)
  noShowCount      Int      @default(0)
  currentStamps    Int      @default(0)
  acceptsMarketing Boolean  @default(true)
  privateNotes     String? // Notas privadas del negocio sobre este cliente (CRM light)
  businessId       String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments      Appointment[]
  loyaltyCodes      LoyaltyCode[]
  recurringBookings RecurringBooking[]
  productionOrders  ProductionOrder[]

  @@unique([businessId, email])
  @@index([businessId])
}

// ==========================================
// LOYALTY / FIDELIZACIÃƒâ€œN
// ==========================================

model LoyaltyCode {
  id            String   @id @default(cuid())
  code          String   @unique
  clientId      String
  businessId    String
  discountType  String // 'PERCENTAGE' | 'FIXED'
  discountValue Int
  rewardName    String?
  isUsed        Boolean  @default(false)
  createdAt     DateTime @default(now())

  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([businessId])
}

// ==========================================
// AFFILIATES
// ==========================================

model Affiliate {
  id            String   @id @default(cuid())
  referralCode  String   @unique
  businessId    String   @unique
  paidReferrals Int      @default(0)
  spentTokens   Int      @default(0)
  createdAt     DateTime @default(now())

  business           Business   @relation("AffiliateOwner", fields: [businessId], references: [id], onDelete: Cascade)
  referredBusinesses Business[] @relation("ReferredBy")
  prizes             Prize[]

  @@index([referralCode])
}

enum PrizeStatus {
  AVAILABLE
  ACTIVE
  USED
}

model Prize {
  id          String      @id @default(cuid())
  affiliateId String
  type        String // 'PERCENTAGE' | 'FREE_MONTH'
  percentage  Int? // 10, 15, 20, 30, 50
  freeMonths  Int? // 1 or 3
  name        String // "El Fix Rápido", "Modo Dios", etc.
  status      PrizeStatus @default(AVAILABLE)
  createdAt   DateTime    @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([affiliateId, status])
}

// ==========================================
// MARKETING CAMPAIGNS
// ==========================================

model MarketingCampaign {
  id           String   @id @default(cuid())
  businessId   String
  subject      String
  body         String
  audienceSize Int
  sentAt       DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, sentAt])
}

// ==========================================
// AUDIT LOG (WORM: Write Once, Read Many)
// ==========================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String? // JSON stringified payload
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model SystemError {
  id        String   @id @default(cuid())
  source    String
  message   String
  stack     String?
  userId    String?
  details   String? // JSON string
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([source])
}
