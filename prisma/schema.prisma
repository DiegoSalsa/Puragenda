generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// AUTH & USERS
// ==========================================

enum UserRole {
  ADMIN
  RECEPTIONIST
  STAFF
  SUPERADMIN
}

enum ClientPortalTokenPurpose {
  MAGIC_ACCESS
  VERIFY_ACCOUNT
  RESET_PASSWORD
}

enum ServiceAvailabilityType {
  NORMAL
  SPECIAL
}

enum WidgetPromoPlacement {
  HEADER
  BETWEEN_SERVICES
  FOOTER
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  name            String
  role            UserRole  @default(ADMIN)
  isSuperAdmin    Boolean   @default(false)
  trialUsedAt     DateTime?
  registrationIp  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tokenVersion    Int       @default(1)
  deletedAt       DateTime?
  termsAcceptedAt DateTime?

  businesses                Business[]
  staff                     Staff[]
  auditLogs                 AuditLog[]
  adminLoginCodes           AdminLoginCode[]
  platformDiscountCodes     PlatformDiscountCode[]     @relation("PlatformDiscountCreatedBy")
  adminInteractiveCampaigns AdminInteractiveCampaign[] @relation("AdminInteractiveCampaignCreatedBy")
  googleCalendarConnections GoogleCalendarConnection[]
  storyCampaigns            StoryCampaign[]
  storyPresets              StoryPreset[]
  posPaymentsCreated        PosPayment[]               @relation("PosPaymentCreatedBy")
  settledAppointments       Appointment[]              @relation("AppointmentSettledBy")
  marketplaceAuthorizations MarketplaceListing[]       @relation("MarketplaceListingAuthorizedBy")
}

// ==========================================
// PASSWORD RESET
// ==========================================

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model ClientPortalToken {
  id         String                   @id @default(cuid())
  email      String
  tokenHash  String                   @unique
  expiresAt  DateTime
  consumedAt DateTime?
  purpose    ClientPortalTokenPurpose @default(MAGIC_ACCESS)
  createdAt  DateTime                 @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

model ClientPortalAccount {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  phone           String?
  rut             String?
  defaultAddress  String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions ClientPortalSession[]

  @@index([emailVerifiedAt])
}

model ClientPortalSession {
  id         String   @id @default(cuid())
  accountId  String
  tokenHash  String   @unique
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  account ClientPortalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
  @@index([expiresAt])
}

model AdminLoginCode {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// ==========================================
// ANTI-FRAUD
// ==========================================

model BlacklistedIp {
  id        String   @id @default(cuid())
  ip        String   @unique
  reason    String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([ip])
}

// ==========================================
// SUBSCRIPTIONS
// ==========================================

enum SubscriptionPlan {
  INDIVIDUAL
  EQUIPO
  TEST
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  INACTIVE
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum RecurringMode {
  FIXED_DAYS // El negocio fija exactamente que dias (ej: L/M/V)
  DAYS_WITH_REST // N dias/semana con minimo de descanso entre sesiones
  FREE_MINIMUM // Libre con minimo de dias semanales, cliente elige
}

enum RecurringStatus {
  PENDING_APPROVAL // Esperando que el negocio apruebe
  ACTIVE // Corriendo normalmente
  PAUSED // Pausada temporalmente
  CANCELLED // Cancelada por el negocio o el cliente
  COMPLETED // Termino el periodo natural
}

enum DepositPaymentMode {
  MERCADOPAGO
  MANUAL_LINK
}

enum BookingDiscountType {
  PERCENTAGE
  FIXED
}

model Subscription {
  id                           String             @id @default(cuid())
  plan                         SubscriptionPlan   @default(INDIVIDUAL)
  status                       SubscriptionStatus @default(ACTIVE)
  billingCycle                 BillingCycle       @default(MONTHLY)
  isTrial                      Boolean            @default(false)
  trialEndsAt                  DateTime?
  extraStaffCount              Int                @default(0)
  pendingDiscountPercentage    Int?
  hasCountedAsPaidReferral     Boolean            @default(false)
  trialWarningEmailSent        Boolean            @default(false)
  freeMonthsRemaining          Int                @default(0)
  activePrizeId                String?
  promoName                    String?
  promoFreeMonthsRemaining     Int                @default(0)
  promoDiscountPercentage      Int?
  promoDiscountMonthsRemaining Int                @default(0)
  nextBillingOverrideAmount    Int?
  billingNotes                 String?
  lastBillingSyncAt            DateTime?
  lastBillingSyncError         String?
  businessId                   String             @unique
  mpCustomerId                 String?
  mpSubscriptionId             String?
  paddleCustomerId             String?            @unique
  paddleSubscriptionId         String?            @unique
  paddlePriceIds               String[]           @default([])
  paddleLastEventAt            DateTime?
  paddleLastEventId            String?
  currentPeriodEnd             DateTime?
  paymentFailedAt              DateTime?
  gracePeriodEndsAt            DateTime?
  nextPaymentAttemptAt         DateTime?
  lastInvoiceId                String?
  lastInvoiceStatus            String?
  lastPaymentId                String?
  lastPaymentStatus            String?
  lastPaymentStatusDetail      String?
  lastPaymentAttemptAt         DateTime?
  paymentRetryCount            Int                @default(0)
  dunningEmailSentAt           DateTime?
  graceExpiryWarningSentAt     DateTime?
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt

  business                    Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platformDiscountRedemptions PlatformDiscountRedemption[]

  @@index([status, gracePeriodEndsAt])
}

// ==========================================
// BUSINESS & SERVICES
// ==========================================

model Business {
  id                                           String             @id @default(cuid())
  name                                         String
  slug                                         String             @unique
  apiKey                                       String             @unique
  logoUrl                                      String?
  address                                      String?
  mapsUrl                                      String?
  primaryColor                                 String             @default("#7C3AED")
  secondaryColor                               String             @default("#5B21B6")
  backgroundColor                              String             @default("#0A0A0A")
  textColor                                    String             @default("#FFFFFF")
  textMutedColor                               String             @default("#FFFFFF66")
  widgetFontSize                               Int                @default(14)
  brandColor                                   String?
  maxServicesPerBooking                        Int                @default(1)
  groupServicesByCategory                      Boolean            @default(false)
  widgetCornerRadius                           Int                @default(16)
  widgetShadowStyle                            String             @default("soft")
  widgetHeaderAlign                            String             @default("left")
  // ── Abono (Deposit) Config ──
  depositRequired                              Boolean            @default(false)
  depositPaymentMode                           DepositPaymentMode @default(MERCADOPAGO)
  allowedOrigins                               String[]           @default([])
  countryCode                                  String             @default("CL")
  currencyCode                                 String             @default("CLP")
  timezone                                     String             @default("America/Santiago")
  locale                                       String             @default("es")
  ownerId                                      String?
  referredByAffiliateId                        String?
  // ── Mercado Pago OAuth (Marketplace) ──
  mpAccessToken                                String?
  mpRefreshToken                               String?
  mpUserId                                     String?
  mpTokenExpiresAt                             DateTime?
  // ── Loyalty / Fidelización ──
  isLoyaltyEnabled                             Boolean            @default(false)
  stampsRequired                               Int                @default(5)
  rewardName                                   String?
  discountType                                 String? // 'PERCENTAGE' | 'FIXED'
  discountValue                                Int?
  loyaltyCodePrefix                            String             @default("PREMIO")
  // ── Politicas del negocio ──
  requiresClientRut                            Boolean            @default(false) // Pedir RUT en el widget
  allowRescheduling                            Boolean            @default(false) // Permitir que clientes reagenden
  rescheduleHoursLimit                         Int                @default(24) // Horas minimas de anticipacion para reagendar
  includeAppointmentActionsInConfirmationEmail Boolean            @default(false)
  // ── Configuración de agenda ──
  allowSameDayBookings                         Boolean            @default(false) // Permite agendar para hoy
  slotInterval                                 Int                @default(60) // Minutos entre cada bloque de hora disponible
  minAdvanceBookingMinutes                     Int                @default(120) // Minutos de anticipación (solo si allowSameDayBookings=true)
  productionOrdersEnabled                      Boolean            @default(false)
  createdAt                                    DateTime           @default(now())
  updatedAt                                    DateTime           @updatedAt
  deletedAt                                    DateTime?

  owner                       User?                        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  referredByAffiliate         Affiliate?                   @relation("ReferredBy", fields: [referredByAffiliateId], references: [id], onDelete: SetNull)
  affiliate                   Affiliate?                   @relation("AffiliateOwner")
  services                    Service[]
  serviceCategories           ServiceCategory[]
  staff                       Staff[]
  appointments                Appointment[]
  clients                     Client[]
  subscription                Subscription?
  businessHours               BusinessHours[]
  blockedDates                BlockedDate[]
  loyaltyCodes                LoyaltyCode[]
  marketingCampaigns          MarketingCampaign[]
  recurringBookings           RecurringBooking[]
  productionOrders            ProductionOrder[]
  platformDiscountRedemptions PlatformDiscountRedemption[]
  widgetThemes                WidgetTheme[]
  widgetPromoBlocks           WidgetPromoBlock[]
  bookingDiscountCodes        BookingDiscountCode[]
  accessProfiles              AccessProfile[]
  googleCalendarConnections   GoogleCalendarConnection[]
  scheduleOverrides           BusinessScheduleOverride[]
  locations                   BusinessLocation[]
  storyCampaigns              StoryCampaign[]
  storyPresets                StoryPreset[]
  posPayments                 PosPayment[]
  marketplaceListings         MarketplaceListing[]

  @@index([ownerId])
  @@index([referredByAffiliateId])
}

// A business is the commercial account. A location is the physical place where
// appointments happen. Keeping them separate lets one account share its
// catalogue and subscription while operating independent calendars.
model BusinessLocation {
  id         String   @id @default(cuid())
  businessId String
  name       String
  slug       String
  address    String?
  mapsUrl    String?
  timezone   String
  isPrimary  Boolean  @default(false)
  isActive   Boolean  @default(false)
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business          Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  hours             LocationHours[]
  scheduleOverrides LocationScheduleOverride[]
  services          LocationService[]
  staff             StaffLocation[]
  appointments      Appointment[]
  recurringBookings RecurringBooking[]
  productionOrders  ProductionOrder[]
  scheduleBlocks    ScheduleBlock[]
  storyCampaigns      StoryCampaign[]
  marketplaceListings MarketplaceListing[]

  @@unique([businessId, slug])
  @@index([businessId, isActive, position])
}

model LocationHours {
  id         String  @id @default(cuid())
  locationId String
  dayOfWeek  Int
  startTime  String
  endTime    String
  isOpen     Boolean @default(true)
  breakStart String?
  breakEnd   String?

  location BusinessLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, dayOfWeek])
  @@index([locationId])
}

model LocationScheduleOverride {
  id         String   @id @default(cuid())
  locationId String
  date       DateTime @db.Date
  startTime  String?
  endTime    String?
  isOpen     Boolean  @default(true)
  breakStart String?
  breakEnd   String?
  createdAt  DateTime @default(now())

  location BusinessLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, date])
  @@index([locationId, date])
}

model LocationService {
  locationId String
  serviceId  String
  createdAt  DateTime @default(now())

  location BusinessLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  service  Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([locationId, serviceId])
  @@index([serviceId])
}

model StaffLocation {
  id         String   @id @default(cuid())
  staffId    String
  locationId String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  staff    Staff                   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  location BusinessLocation        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  schedule StaffLocationSchedule[]

  @@unique([staffId, locationId])
  @@index([locationId, isActive])
}

model StaffLocationSchedule {
  id              String  @id @default(cuid())
  staffLocationId String
  dayOfWeek       Int
  startTime       String
  endTime         String
  isWorking       Boolean @default(true)
  breakStart      String?
  breakEnd        String?

  staffLocation StaffLocation @relation(fields: [staffLocationId], references: [id], onDelete: Cascade)

  @@unique([staffLocationId, dayOfWeek])
  @@index([staffLocationId])
}

model WidgetTheme {
  id              String   @id @default(cuid())
  name            String
  category        String   @default("Personalizado")
  primaryColor    String
  secondaryColor  String
  backgroundColor String
  textColor       String
  textMutedColor  String
  fontSize        Int      @default(14)
  cornerRadius    Int      @default(16)
  shadowStyle     String   @default("soft")
  headerAlign     String   @default("left")
  logoUrl         String?
  businessId      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
  @@index([businessId, category])
}

model WidgetPromoBlock {
  id                  String               @id @default(cuid())
  title               String
  subtitle            String?
  imageUrl            String
  cloudinaryPublicId  String?
  linkUrl             String?
  placement           WidgetPromoPlacement @default(HEADER)
  position            Int                  @default(0)
  isVisible           Boolean              @default(true)
  textAlign           String               @default("left")
  discountType        String?
  discountValue       Int?
  discountStartsAt    DateTime?
  discountEndsAt      DateTime?
  discountMinSubtotal Int                  @default(0)
  businessId          String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([businessId, placement, position])
  @@index([businessId, isVisible, discountStartsAt, discountEndsAt], map: "WidgetPromoBlock_discount_active_idx")
}

// ==========================================
// BUSINESS BOOKING DISCOUNT CODES
// ==========================================

model BookingDiscountCode {
  id            String              @id @default(cuid())
  businessId    String
  code          String
  discountType  BookingDiscountType
  discountValue Int
  minSubtotal   Int                 @default(0)
  startsAt      DateTime?
  expiresAt     DateTime?
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([businessId, code])
  @@index([businessId, isActive, startsAt, expiresAt])
}

model AccessProfile {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  permissions String[]  @default([])
  isSystem    Boolean   @default(false)
  baseRole    UserRole?
  businessId  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    Staff[]

  @@unique([businessId, name])
  @@index([businessId, isSystem])
}

// ==========================================
// PLATFORM DISCOUNT CODES
// ==========================================

model PlatformDiscountCode {
  id              String    @id @default(cuid())
  code            String    @unique
  name            String
  discountType    String // 'PERCENTAGE' | 'FIXED'
  discountValue   Int
  maxRedemptions  Int?
  redeemedCount   Int       @default(0)
  startsAt        DateTime?
  expiresAt       DateTime?
  trialEndsAtFrom DateTime?
  trialEndsAtTo   DateTime?
  isActive        Boolean   @default(true)
  appliesToPlans  String[]  @default([])
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  createdBy   User?                        @relation("PlatformDiscountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  redemptions PlatformDiscountRedemption[]

  @@index([isActive])
  @@index([expiresAt])
}

model PlatformDiscountRedemption {
  id               String    @id @default(cuid())
  discountCodeId   String
  businessId       String
  subscriptionId   String?
  status           String    @default("PENDING") // 'PENDING' | 'APPLIED'
  originalAmount   Int
  discountedAmount Int
  createdAt        DateTime  @default(now())
  appliedAt        DateTime?

  discountCode PlatformDiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([discountCodeId, businessId])
  @@index([businessId])
  @@index([subscriptionId])
  @@index([status])
}

// ==========================================
// SUPERADMIN INTERACTIVE EMAILS
// ==========================================

model AdminInteractiveCampaign {
  id          String   @id @default(cuid())
  title       String
  type        String // 'SATISFACTION' | 'FORM'
  question    String
  fields      Json?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy  User?                       @relation("AdminInteractiveCampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  recipients AdminInteractiveRecipient[]
  responses  AdminInteractiveResponse[]

  @@index([type])
  @@index([createdAt])
}

model AdminInteractiveRecipient {
  id           String    @id @default(cuid())
  campaignId   String
  email        String
  name         String
  businessName String?
  businessSlug String?
  token        String    @unique
  createdAt    DateTime  @default(now())
  respondedAt  DateTime?

  campaign AdminInteractiveCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  response AdminInteractiveResponse?

  @@index([campaignId])
  @@index([email])
}

model AdminInteractiveResponse {
  id          String   @id @default(cuid())
  campaignId  String
  recipientId String   @unique
  rating      Int?
  answers     Json?
  comment     String?
  createdAt   DateTime @default(now())

  campaign  AdminInteractiveCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient AdminInteractiveRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([createdAt])
}

model BusinessHours {
  id         String  @id @default(cuid())
  dayOfWeek  Int
  startTime  String
  endTime    String
  isOpen     Boolean @default(true)
  breakStart String?
  breakEnd   String?
  businessId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

model BusinessScheduleOverride {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  startTime  String? // null if isOpen = false
  endTime    String?
  isOpen     Boolean  @default(true)
  breakStart String?
  breakEnd   String?
  businessId String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
  @@index([businessId, date])
}

model BlockedDate {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  reason     String?
  businessId String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
  @@index([businessId])
}

model Staff {
  id              String   @id @default(cuid())
  name            String
  email           String?
  imageUrl        String?
  businessId      String
  userId          String?
  accessProfileId String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business                  Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user                      User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  accessProfile             AccessProfile?             @relation(fields: [accessProfileId], references: [id], onDelete: SetNull)
  appointments              Appointment[]
  schedule                  StaffSchedule[]
  scheduleBlocks            ScheduleBlock[]
  services                  Service[]
  recurringBookings         RecurringBooking[]
  googleCalendarConnections GoogleCalendarConnection[]
  scheduleOverrides         StaffScheduleOverride[]
  locations                 StaffLocation[]
  storyCampaigns            StoryCampaign[]

  @@unique([businessId, email])
  @@index([businessId])
  @@index([accessProfileId])
}

model StaffSchedule {
  id         String  @id @default(cuid())
  dayOfWeek  Int
  startTime  String
  endTime    String
  isWorking  Boolean @default(true)
  breakStart String?
  breakEnd   String?
  staffId    String

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@index([staffId])
}

model StaffScheduleOverride {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  startTime  String?
  endTime    String?
  isWorking  Boolean  @default(true)
  breakStart String?
  breakEnd   String?
  staffId    String
  createdAt  DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([staffId, date])
}

enum ScheduleBlockType {
  UNAVAILABLE
  PRIORITY
}

model ScheduleBlock {
  id         String            @id @default(cuid())
  staffId    String
  locationId String?
  startTime  DateTime
  endTime    DateTime
  reason     String?
  type       ScheduleBlockType @default(UNAVAILABLE)
  releaseAt  DateTime?
  createdAt  DateTime          @default(now())

  staff    Staff             @relation(fields: [staffId], references: [id], onDelete: Cascade)
  location BusinessLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([staffId])
  @@index([staffId, startTime, endTime])
  @@index([staffId, type, releaseAt])
  @@index([locationId])
}

model Service {
  id                       String                  @id @default(cuid())
  name                     String
  position                 Int                     @default(0)
  description              String?
  imageUrl                 String?
  duration                 Int
  price                    Float
  depositAmount            Int                     @default(0) // Amount in the business currency
  depositPaymentUrl        String?
  bookingMode              ServiceBookingMode      @default(APPOINTMENT)
  productionScheduleMode   ProductionScheduleMode  @default(WEEKLY)
  weeklyProductionCapacity Int                     @default(5)
  productionWeeksAhead     Int                     @default(24)
  productionLeadTimeWeeks  Int                     @default(1)
  customProductionWindows  Json?
  productionDepositPercent Int                     @default(50)
  requiresReferenceImages  Boolean                 @default(false)
  businessId               String
  categoryId               String?
  availabilityType         ServiceAvailabilityType @default(NORMAL)
  specialWeekDays          Int[]                   @default([])
  specialStartDate         DateTime?               @db.Date
  specialEndDate           DateTime?               @db.Date
  specialStartTime         String?
  specialEndTime           String?

  business          Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category          ServiceCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  appointments      Appointment[]
  staff             Staff[]
  recurringPlan     RecurringPlan?
  recurringBookings RecurringBooking[]
  optionCategories  ServiceOptionCategory[]
  productionOrders  ProductionOrder[]
  locations         LocationService[]

  @@index([businessId])
  @@index([categoryId])
  @@index([businessId, position])
}

model ServiceCategory {
  id         String   @id @default(cuid())
  name       String
  position   Int      @default(0)
  businessId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([businessId, name])
  @@index([businessId, position])
}

enum ServiceBookingMode {
  APPOINTMENT
  PRODUCTION
}

enum ProductionScheduleMode {
  WEEKLY
  CUSTOM
}

enum ProductionOrderStatus {
  AWAITING_DEPOSIT
  REFERENCES_REVIEW
  QUEUED
  IN_PRODUCTION
  QUALITY_CHECK
  BALANCE_DUE
  READY_TO_SHIP
  SHIPPED
  COMPLETED
  CANCELLED
}

model ProductionOrder {
  id                    String                @id @default(cuid())
  orderNumber           String                @unique
  businessId            String
  locationId            String?
  serviceId             String
  clientId              String?
  customerName          String
  customerEmail         String
  customerPhone         String
  petName               String
  petDetails            String
  referenceImageUrls    String[]              @default([])
  productionWeek        DateTime              @db.Date
  productionWindowKey   String?
  productionWindowLabel String?
  productionWindowEnd   DateTime?             @db.Date
  selectedOptions       Json?
  totalPrice            Float
  depositAmount         Int
  balanceAmount         Int
  depositPaymentStatus  PaymentStatus         @default(PENDING)
  balancePaymentStatus  PaymentStatus         @default(NONE)
  depositMpPreferenceId String?
  depositMpPaymentId    String?
  balanceMpPreferenceId String?
  balanceMpPaymentId    String?
  deliveryMethod        String                @default("COORDINATE")
  customerAddress       String?
  status                ProductionOrderStatus @default(AWAITING_DEPOSIT)
  internalNotes         String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location BusinessLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  service  Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  client   Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([serviceId, productionWeek])
  @@index([serviceId, productionWindowKey])
  @@index([clientId])
  @@index([businessId, productionWeek])
  @@index([locationId, productionWeek])
  @@index([depositMpPreferenceId])
}

model ServiceOptionCategory {
  id            String   @id @default(cuid())
  name          String
  isRequired    Boolean  @default(false)
  maxSelections Int      @default(1)
  position      Int      @default(0)
  serviceId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  service      Service                    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  alternatives ServiceOptionAlternative[]

  @@index([serviceId])
  @@index([serviceId, position])
}

model ServiceOptionAlternative {
  id            String   @id @default(cuid())
  name          String
  priceDelta    Float    @default(0)
  durationDelta Int      @default(0)
  isHomeService Boolean  @default(false)
  position      Int      @default(0)
  categoryId    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category ServiceOptionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([categoryId, position])
}

// ==========================================
// RECURRING BOOKINGS
// ==========================================

model RecurringPlan {
  id                    String        @id @default(cuid())
  serviceId             String        @unique
  mode                  RecurringMode @default(FIXED_DAYS)
  // FIXED_DAYS: dias exactos de la semana (0=Dom, 1=Lun, ... 6=Sab)
  fixedDays             Int[]         @default([])
  // DAYS_WITH_REST / FREE_MINIMUM
  daysPerWeek           Int? // cuantos dias por semana
  minRestDays           Int? // minimo dias de descanso entre sesiones
  // Opciones de duracion que el cliente puede elegir (en meses, ej: [1,2,3])
  durationOptions       Int[]         @default([1])
  // Rango maximo de dias desde hoy que el cliente puede elegir como fecha de inicio
  startDateRangeDays    Int           @default(14)
  // Aprobacion manual del negocio antes de activar
  requiresApproval      Boolean       @default(false)
  // Formulario de salud/condiciones
  requiresHealthForm    Boolean       @default(false)
  healthQuestions       String[]      @default([])
  // Pedir RUT al cliente
  requiresRut           Boolean       @default(false)
  // Mensaje personalizado para el email de renovacion
  renewalMessage        String?
  // Dias antes del vencimiento para avisar al cliente
  expirationWarningDays Int           @default(7)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  service           Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  recurringBookings RecurringBooking[]

  @@index([serviceId])
}

model RecurringBooking {
  id                    String          @id @default(cuid())
  businessId            String
  locationId            String?
  serviceId             String
  recurringPlanId       String
  staffId               String?
  clientId              String?
  customerName          String
  customerEmail         String
  customerPhone         String?
  customerAddress       String?
  customerRut           String?
  status                RecurringStatus @default(PENDING_APPROVAL)
  // Dias elegidos por el cliente (0=Dom, 1=Lun, ... 6=Sab)
  selectedDays          Int[]
  // Hora por dia: JSON { "1": "08:00", "3": "10:00", "5": "09:00" }
  selectedTimes         Json
  startDate             DateTime
  endDate               DateTime
  durationMonths        Int
  // Formulario de salud
  healthAnswers         Json? // Respuestas a healthQuestions
  healthFreeText        String? // Texto libre del cliente
  healthAccepted        Boolean         @default(false) // Acepto que pueden rechazar
  // Estado de pausa
  pausedUntil           DateTime?
  // Notas internas del negocio (solo lo ve el negocio)
  internalNotes         String?
  // Control de emails automaticos ya enviados
  expirationWarningSent Boolean         @default(false)
  renewalOffered        Boolean         @default(false)
  // Token para el link de gestion del cliente (/mi-plan/[token])
  managementToken       String?         @unique
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  business         Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location         BusinessLocation?          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  service          Service                    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  recurringPlan    RecurringPlan              @relation(fields: [recurringPlanId], references: [id], onDelete: Cascade)
  staff            Staff?                     @relation(fields: [staffId], references: [id], onDelete: SetNull)
  client           Client?                    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  appointments     Appointment[]
  sessionOverrides RecurringSessionOverride[]

  @@index([businessId])
  @@index([serviceId])
  @@index([staffId])
  @@index([clientId])
  @@index([status])
  @@index([businessId, status])
  @@index([locationId, status])
}

model RecurringSessionOverride {
  id                 String   @id @default(cuid())
  recurringBookingId String
  // Fecha original del turno que se modifica
  originalDate       DateTime
  // CANCELLED o TIME_CHANGED
  action             String
  // Si es TIME_CHANGED, la nueva hora ("10:00")
  newTime            String?
  reason             String?
  requestedByClient  Boolean  @default(false)
  // Control de email de aviso enviado
  warningSent        Boolean  @default(false)
  createdAt          DateTime @default(now())

  recurringBooking RecurringBooking @relation(fields: [recurringBookingId], references: [id], onDelete: Cascade)

  @@index([recurringBookingId])
  @@index([originalDate])
  @@index([recurringBookingId, originalDate])
}

// ==========================================
// APPOINTMENTS
// ==========================================

enum AppointmentStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  CANCELLED
  CHECKED_IN
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum DepositReceiptStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum PosPaymentChannel {
  QR
  POINT
}

enum PosPaymentStatus {
  CREATING
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  REFUNDED
  FAILED
}

model Appointment {
  id                           String               @id @default(cuid())
  customerName                 String
  customerEmail                String
  customerPhone                String?
  customerAddress              String?
  startTime                    DateTime
  endTime                      DateTime
  status                       AppointmentStatus    @default(PENDING)
  additionalServiceIds         String[]             @default([])
  totalDuration                Int?
  totalPrice                   Float?
  originalTotalPrice           Float?
  discountAmount               Float?
  promotionId                  String?
  promotionTitle               String?
  bookingDiscountCodeId        String?
  bookingDiscountCodeValue     String?
  selectedOptions              Json?
  businessId                   String
  locationId                   String?
  serviceId                    String
  staffId                      String?
  clientId                     String?
  reminderSent                 Boolean              @default(false)
  actionToken                  String?              @unique
  customerActionTokenHash      String?              @unique
  customerActionTokenExpiresAt DateTime?
  customerActionTokenUsedAt    DateTime?
  internalNotes                String?
  sessionBaseAmount            Float?
  tipAmount                    Float                @default(0)
  postSessionItems             Json?
  paymentMethod                String?
  settledAt                    DateTime?
  settledByUserId              String?
  // ── Deposit Payment ──
  depositAmount                Int? // Amount charged in the business currency
  depositPaymentUrl            String? // Snapshot of an external manual payment link
  paymentStatus                PaymentStatus        @default(NONE)
  mpPaymentId                  String? // MercadoPago payment ID
  mpPreferenceId               String? // MercadoPago preference ID
  depositReceiptStatus         DepositReceiptStatus @default(NONE)
  depositReceiptPublicId       String?
  depositReceiptResourceType   String?
  depositReceiptFormat         String?
  depositReceiptOriginalName   String?
  depositReceiptUploadedAt     DateTime?
  depositReceiptReviewedAt     DateTime?
  depositReceiptReviewedById   String?
  depositReceiptTokenHash      String?
  // ── Recurring ──
  recurringBookingId           String? // FK a RecurringBooking si es parte de un plan
  storyCampaignId              String?
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt

  business               Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location               BusinessLocation?       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  service                Service                 @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff                  Staff?                  @relation(fields: [staffId], references: [id], onDelete: SetNull)
  client                 Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)
  recurringBooking       RecurringBooking?       @relation(fields: [recurringBookingId], references: [id], onDelete: SetNull)
  promotion              WidgetPromoBlock?       @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  bookingDiscountCode    BookingDiscountCode?    @relation(fields: [bookingDiscountCodeId], references: [id], onDelete: SetNull)
  storyCampaign          StoryCampaign?          @relation(fields: [storyCampaignId], references: [id], onDelete: SetNull)
  googleCalendarEvent    GoogleCalendarEvent?
  depositPaymentDelivery DepositPaymentDelivery?
  posPayments            PosPayment[]
  settledByUser          User?                   @relation("AppointmentSettledBy", fields: [settledByUserId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([serviceId])
  @@index([staffId, startTime, endTime])
  @@index([startTime])
  @@index([clientId])
  @@index([recurringBookingId])
  @@index([promotionId])
  @@index([bookingDiscountCodeId])
  @@index([storyCampaignId])
  @@index([locationId, startTime, endTime])
  @@index([settledByUserId])
}

/// Durable delivery record for the non-transactional work triggered by a
/// confirmed appointment deposit. The unique appointment key makes the work
/// idempotent across return URLs, webhooks and retry jobs.
model DepositPaymentDelivery {
  id                       String    @id @default(cuid())
  appointmentId            String    @unique
  paymentId                String
  ownerEmailDeliveredAt    DateTime?
  staffEmailDeliveredAt    DateTime?
  customerEmailDeliveredAt DateTime?
  calendarSyncedAt         DateTime?
  attempts                 Int       @default(0)
  lastError                String?
  nextAttemptAt            DateTime  @default(now())
  lockedUntil              DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([nextAttemptAt])
}

model PosPayment {
  id                String            @id @default(cuid())
  businessId        String
  appointmentId     String
  createdByUserId   String?
  channel           PosPaymentChannel @default(QR)
  status            PosPaymentStatus  @default(CREATING)
  amount            Int
  currency          String
  externalReference String            @unique
  idempotencyKey    String            @unique
  providerOrderId   String?           @unique
  providerPaymentId String?
  providerUserId    String?
  qrData            String?           @db.Text
  statusDetail      String?
  expiresAt         DateTime?
  paidAt            DateTime?
  lastSyncedAt      DateTime?
  failureReason     String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdByUser User?       @relation("PosPaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([businessId, status, createdAt])
  @@index([appointmentId, status, createdAt])
  @@index([createdByUserId])
}

model StoryCampaign {
  id               String    @id @default(cuid())
  token            String    @unique
  businessId       String
  createdByUserId  String?
  locationId       String?
  staffId          String?
  serviceIds       String[]  @default([])
  range            String
  targetDate       DateTime? @db.Date
  headline         String
  template         String
  destinationUrl   String    @db.Text
  slotCount        Int       @default(0)
  potentialRevenue Float     @default(0)
  linkVisits       Int       @default(0)
  downloadCount    Int       @default(0)
  shareCount       Int       @default(0)
  copiedCount      Int       @default(0)
  status           String    @default("PUBLISHED")
  objective        String    @default("FILL_SLOTS")
  configuration    Json?
  publishedAt      DateTime?
  archivedAt       DateTime?
  lastVisitedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdByUser User?             @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  location      BusinessLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  staff         Staff?            @relation(fields: [staffId], references: [id], onDelete: SetNull)
  appointments  Appointment[]

  @@index([businessId, createdAt])
  @@index([businessId, status, createdAt])
  @@index([locationId])
  @@index([staffId])
}

model StoryPreset {
  id              String   @id @default(cuid())
  businessId      String
  createdByUserId String?
  name            String
  configuration   Json
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdByUser User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([businessId, name])
  @@index([businessId, isDefault, updatedAt])
  @@index([createdByUserId])
}

model GoogleCalendarConnection {
  id                      String    @id @default(cuid())
  businessId              String
  staffId                 String?
  userId                  String
  scope                   String
  scopeKey                String
  googleEmail             String
  calendarId              String    @default("primary")
  calendarName            String?
  accessTokenEncrypted    String    @db.Text
  refreshTokenEncrypted   String?   @db.Text
  tokenExpiresAt          DateTime?
  syncEnabled             Boolean   @default(true)
  includeCustomerAttendee Boolean   @default(true)
  lastSyncedAt            DateTime?
  lastSyncError           String?   @db.Text
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  business Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    Staff?                @relation(fields: [staffId], references: [id], onDelete: Cascade)
  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  events   GoogleCalendarEvent[]

  @@unique([businessId, scopeKey])
  @@index([businessId, scope, syncEnabled])
  @@index([staffId, syncEnabled])
  @@index([userId])
}

model GoogleCalendarEvent {
  id             String   @id @default(cuid())
  appointmentId  String   @unique
  connectionId   String
  calendarId     String
  googleEventId  String
  googleEventUrl String?
  etag           String?
  lastSyncedAt   DateTime @default(now())
  syncError      String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  appointment Appointment              @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  connection  GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, calendarId, googleEventId])
  @@index([connectionId])
  @@index([lastSyncedAt])
}

// ==========================================
// CRM Ã¢â‚¬â€ CLIENTS
// ==========================================

model Client {
  id               String   @id @default(cuid())
  name             String
  email            String
  phone            String?
  rut              String? // RUT del cliente (opcional, configurable por negocio)
  totalSpent       Float    @default(0)
  noShowCount      Int      @default(0)
  currentStamps    Int      @default(0)
  acceptsMarketing Boolean  @default(true)
  privateNotes     String? // Notas privadas del negocio sobre este cliente (CRM light)
  businessId       String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments      Appointment[]
  loyaltyCodes      LoyaltyCode[]
  recurringBookings RecurringBooking[]
  productionOrders  ProductionOrder[]

  @@unique([businessId, email])
  @@index([businessId])
}

// ==========================================
// LOYALTY / FIDELIZACIÃƒâ€œN
// ==========================================

model LoyaltyCode {
  id            String   @id @default(cuid())
  code          String   @unique
  clientId      String
  businessId    String
  discountType  String // 'PERCENTAGE' | 'FIXED'
  discountValue Int
  rewardName    String?
  isUsed        Boolean  @default(false)
  createdAt     DateTime @default(now())

  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([businessId])
}

// ==========================================
// AFFILIATES
// ==========================================

model Affiliate {
  id            String   @id @default(cuid())
  referralCode  String   @unique
  businessId    String   @unique
  paidReferrals Int      @default(0)
  spentTokens   Int      @default(0)
  createdAt     DateTime @default(now())

  business           Business   @relation("AffiliateOwner", fields: [businessId], references: [id], onDelete: Cascade)
  referredBusinesses Business[] @relation("ReferredBy")
  prizes             Prize[]

  @@index([referralCode])
}

enum PrizeStatus {
  AVAILABLE
  ACTIVE
  USED
}

model Prize {
  id          String      @id @default(cuid())
  affiliateId String
  type        String // 'PERCENTAGE' | 'FREE_MONTH'
  percentage  Int? // 10, 15, 20, 30, 50
  freeMonths  Int? // 1 or 3
  name        String // "El Fix Rápido", "Modo Dios", etc.
  status      PrizeStatus @default(AVAILABLE)
  createdAt   DateTime    @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([affiliateId, status])
}

// ==========================================
// MARKETING CAMPAIGNS
// ==========================================

model MarketingCampaign {
  id           String   @id @default(cuid())
  businessId   String
  subject      String
  body         String
  audienceSize Int
  sentAt       DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, sentAt])
}

// ==========================================
// AUDIT LOG (WORM: Write Once, Read Many)
// ==========================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String? // JSON stringified payload
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model SystemError {
  id        String   @id @default(cuid())
  source    String
  message   String
  stack     String?
  userId    String?
  details   String? // JSON string
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([source])
}

// ==========================================
// PRIVACY-SAFE PRODUCT ANALYTICS
// ==========================================

// Events are intentionally decoupled from the user and business relations. This
// keeps the analytics store minimal: it can be aggregated or deleted without
// touching operational records, and no personally identifiable data is required.
model TrackingEvent {
  id                 String    @id @default(cuid())
  event              String
  occurredAt         DateTime  @default(now())
  visitorId          String?
  sessionId          String?
  userId             String?
  businessId         String?
  path               String?
  referrerDomain     String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  properties         Json?
  consentVersion     String?
  consentGrantedAt   DateTime?
  retentionHoldUntil DateTime?
  createdAt          DateTime  @default(now())

  @@index([occurredAt])
  @@index([event, occurredAt])
  @@index([visitorId, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([userId, occurredAt])
  @@index([businessId, event, occurredAt])
}

// Consent records provide server-side evidence of the visitor's analytics choice.
// They intentionally contain only pseudonymous browser identifiers and no form data.
model TrackingConsent {
  id                 String    @id @default(cuid())
  decision           String
  policyVersion      String
  visitorId          String?
  sessionId          String?
  userId             String?
  occurredAt         DateTime  @default(now())
  createdAt          DateTime  @default(now())
  retentionHoldUntil DateTime?

  @@index([occurredAt])
  @@index([visitorId, occurredAt])
  @@index([userId, occurredAt])
}

// Privacy requests are kept in a restricted server-side queue so the team can
// verify identity and meet statutory response deadlines.
model PrivacyRequest {
  id                      String    @id @default(cuid())
  requestType             String
  status                  String    @default("RECEIVED")
  identityStatus          String    @default("PENDING")
  name                    String
  email                   String
  details                 String
  visitorId               String?
  userId                  String?
  dueAt                   DateTime
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  resolvedAt              DateTime?
  resolutionNotes         String?
  responseSentAt          DateTime?
  responseChannel         String?
  responseContent         String?
  initialDueAt            DateTime?
  extensionUsed           Boolean   @default(false)
  extensionNoticeSentAt   DateTime?
  extensionNotes          String?
  acknowledgementSentAt   DateTime?
  acknowledgementError    String?
  adminNotifiedAt         DateTime?
  technicalAction         String?
  technicalActionAt       DateTime?
  technicalActionByUserId String?
  technicalActionEvidence String?
  exportGeneratedAt       DateTime?

  @@index([status, dueAt])
  @@index([email, createdAt])
  @@index([visitorId, createdAt])
}

// Persistent restrictions make opposition, suppression and blocking effective
// across serverless instances. Values derived from email are one-way hashes.
model PrivacyRestriction {
  id              String   @id @default(cuid())
  emailHash       String?
  visitorId       String?
  userId          String?
  scope           String   @default("ANALYTICS")
  reason          String
  sourceRequestId String   @unique
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([emailHash, active])
  @@index([visitorId, active])
  @@index([userId, active])
}

// Shared fixed-window buckets provide rate limiting across Vercel instances.
model ApiRateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// ==========================================
// MARKETPLACE DIRECTORY (admin-curated)
// ==========================================
// Listings are opt-in, unpublished by default, and attached to a physical
// BusinessLocation so multi-branch shops can appear once per sucursal.
// Do not infer category or city from free-text fields.

model MarketplaceCategory {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  // Assignable in Admin → Marketplace. Does not imply SEO routes.
  isActive   Boolean  @default(false)
  // Eligible for marketplace SEO paths. Still gated by indexingEnabled.
  seoEnabled Boolean  @default(false)
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  listings MarketplaceListingCategory[]

  @@index([isActive, position])
  @@index([seoEnabled, position])
}

model MarketplaceLocality {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  regionName  String
  communeName String?
  isActive    Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listings MarketplaceListing[]

  @@index([isActive, position])
}

model MarketplaceListing {
  id                         String    @id @default(cuid())
  businessId                 String
  locationId                 String
  localityId                 String
  authorizationConfirmedAt   DateTime?
  authorizationConfirmedById String?
  publishedAt                DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  business                 Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location                 BusinessLocation       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locality                 MarketplaceLocality    @relation(fields: [localityId], references: [id], onDelete: Restrict)
  authorizationConfirmedBy User?                  @relation("MarketplaceListingAuthorizedBy", fields: [authorizationConfirmedById], references: [id], onDelete: SetNull)
  categories               MarketplaceListingCategory[]

  @@unique([businessId, locationId])
  @@index([publishedAt, localityId])
  @@index([businessId])
  @@index([locationId])
  @@index([authorizationConfirmedById])
}

model MarketplaceListingCategory {
  listingId  String
  categoryId String
  createdAt  DateTime @default(now())

  listing  MarketplaceListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  category MarketplaceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([listingId, categoryId])
  @@index([categoryId, listingId])
}
