// ==========================================
// RECURRING BOOKINGS
// ==========================================

model RecurringPlan {
  id                    String        @id @default(cuid())
  serviceId             String        @unique
  mode                  RecurringMode @default(FIXED_DAYS)
  // FIXED_DAYS: dias exactos de la semana (0=Dom, 1=Lun, ... 6=Sab)
  fixedDays             Int[]         @default([])
  // DAYS_WITH_REST / FREE_MINIMUM
  daysPerWeek           Int? // cuantos dias por semana
  minRestDays           Int? // minimo dias de descanso entre sesiones
  // Opciones de duracion que el cliente puede elegir (en meses, ej: [1,2,3])
  durationOptions       Int[]         @default([1])
  // Rango maximo de dias desde hoy que el cliente puede elegir como fecha de inicio
  startDateRangeDays    Int           @default(14)
  // Aprobacion manual del negocio antes de activar
  requiresApproval      Boolean       @default(false)
  // Formulario de salud/condiciones
  requiresHealthForm    Boolean       @default(false)
  healthQuestions       String[]      @default([])
  // Pedir RUT al cliente
  requiresRut           Boolean       @default(false)
  // Mensaje personalizado para el email de renovacion
  renewalMessage        String?
  // Dias antes del vencimiento para avisar al cliente
  expirationWarningDays Int           @default(7)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  service           Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  recurringBookings RecurringBooking[]

  @@index([serviceId])
}

model RecurringBooking {
  id                    String          @id @default(cuid())
  businessId            String
  locationId            String?
  serviceId             String
  recurringPlanId       String
  staffId               String?
  clientId              String?
  customerName          String
  customerEmail         String
  portalOwnerEmail         String?
  customerPhone         String?
  customerAddress       String?
  customerRut           String?
  status                RecurringStatus @default(PENDING_APPROVAL)
  // Dias elegidos por el cliente (0=Dom, 1=Lun, ... 6=Sab)
  selectedDays          Int[]
  // Hora por dia: JSON { "1": "08:00", "3": "10:00", "5": "09:00" }
  selectedTimes         Json
  startDate             DateTime
  endDate               DateTime
  durationMonths        Int
  // Formulario de salud
  healthAnswers         Json? // Respuestas a healthQuestions
  healthFreeText        String? // Texto libre del cliente
  healthAccepted        Boolean         @default(false) // Acepto que pueden rechazar
  healthAcceptedAt         DateTime?
  healthConsentVersion     String?
  healthConsentSnapshot    Json?
  // Estado de pausa
  pausedUntil           DateTime?
  // Notas internas del negocio (solo lo ve el negocio)
  internalNotes         String?
  // Control de emails automaticos ya enviados
  expirationWarningSent Boolean         @default(false)
  renewalOffered        Boolean         @default(false)
  // Token para el link de gestion del cliente (/mi-plan/[token])
  managementToken       String?         @unique
  managementTokenHash      String?         @unique
  managementTokenExpiresAt DateTime?
  managementTokenRevokedAt DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  business         Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location         BusinessLocation?          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  service          Service                    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  recurringPlan    RecurringPlan              @relation(fields: [recurringPlanId], references: [id], onDelete: Cascade)
  staff            Staff?                     @relation(fields: [staffId], references: [id], onDelete: SetNull)
  client           Client?                    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  appointments     Appointment[]
  sessionOverrides RecurringSessionOverride[]

  @@index([businessId])
  @@index([portalOwnerEmail])
  @@index([serviceId])
  @@index([staffId])
  @@index([clientId])
  @@index([status])
  @@index([businessId, status])
  @@index([locationId, status])
}

model RecurringSessionOverride {
  id                 String   @id @default(cuid())
  recurringBookingId String
  // Fecha original del turno que se modifica
  originalDate       DateTime
  // CANCELLED o TIME_CHANGED
  action             String
  // Si es TIME_CHANGED, la nueva hora ("10:00")
  newTime            String?
  reason             String?
  requestedByClient  Boolean  @default(false)
  // Control de email de aviso enviado
  warningSent        Boolean  @default(false)
  createdAt          DateTime @default(now())

  recurringBooking RecurringBooking @relation(fields: [recurringBookingId], references: [id], onDelete: Cascade)

  @@index([recurringBookingId])
  @@index([originalDate])
  @@index([recurringBookingId, originalDate])
}

// ==========================================
// APPOINTMENTS
// ==========================================

enum AppointmentStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  CANCELLED
  CHECKED_IN
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum DepositReceiptStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum PosPaymentChannel {
  QR
  POINT
}

enum PosPaymentStatus {
  CREATING
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  REFUNDED
  FAILED
}

model Appointment {
  portalOwnerEmail             String?
  contactFlowAttribution       CfAttribution?
  id                           String               @id @default(cuid())
  customerName                 String
  customerEmail                String
  customerPhone                String?
  customerAddress              String?
  startTime                    DateTime
  endTime                      DateTime
  status                       AppointmentStatus    @default(PENDING)
  additionalServiceIds         String[]             @default([])
  totalDuration                Int?
  totalPrice                   Float?
  originalTotalPrice           Float?
  discountAmount               Float?
  giftCardPaidAmount           Int                  @default(0)
  promotionId                  String?
  promotionTitle               String?
  bookingDiscountCodeId        String?
  bookingDiscountCodeValue     String?
  selectedOptions              Json?
  businessId                   String
  locationId                   String?
  serviceId                    String
  staffId                      String?
  clientId                     String?
  reminderSent                 Boolean              @default(false)
  actionToken                  String?              @unique
  customerActionTokenHash      String?              @unique
  customerActionTokenExpiresAt DateTime?
  customerActionTokenUsedAt    DateTime?
  internalNotes                String?
  sessionBaseAmount            Float?
  tipAmount                    Float                @default(0)
  postSessionItems             Json?
  paymentMethod                String?
  settledAt                    DateTime?
  settledByUserId              String?
  // ── Deposit Payment ──
  depositAmount                Int? // Amount charged in the business currency
  depositPaymentUrl            String? // Snapshot of an external manual payment link
  paymentStatus                PaymentStatus        @default(NONE)
  /// Server-issued deadline for an integrated Mercado Pago checkout hold.
  /// Null for manual links, unpaid bookings without a deposit and other flows.
  paymentHoldExpiresAt         DateTime?
  mpPaymentId                  String? // MercadoPago payment ID
  mpPreferenceId               String? // MercadoPago preference ID
  depositReceiptStatus         DepositReceiptStatus @default(NONE)
  depositReceiptPublicId       String?
  depositReceiptResourceType   String?
  depositReceiptFormat         String?
  depositReceiptOriginalName   String?
  depositReceiptUploadedAt     DateTime?
  depositReceiptReviewedAt     DateTime?
  depositReceiptReviewedById   String?
  depositReceiptTokenHash      String?
  // ── Recurring ──
  recurringBookingId           String? // FK a RecurringBooking si es parte de un plan
  storyCampaignId              String?
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt

  business               Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location               BusinessLocation?       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  service                Service                 @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff                  Staff?                  @relation(fields: [staffId], references: [id], onDelete: SetNull)
  client                 Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)
  recurringBooking       RecurringBooking?       @relation(fields: [recurringBookingId], references: [id], onDelete: SetNull)
  promotion              WidgetPromoBlock?       @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  bookingDiscountCode    BookingDiscountCode?    @relation(fields: [bookingDiscountCodeId], references: [id], onDelete: SetNull)
  storyCampaign          StoryCampaign?          @relation(fields: [storyCampaignId], references: [id], onDelete: SetNull)
  googleCalendarEvent    GoogleCalendarEvent?
  depositPaymentDelivery DepositPaymentDelivery?
  posPayments            PosPayment[]
  loyaltyStampEvent      LoyaltyStampEvent?
  giftCardRedemption     GiftCardRedemption?
  giftCardTransactions   GiftCardTransaction[]
  redeemedLoyaltyCode    LoyaltyCode?            @relation("LoyaltyCodeRedemption")
  settledByUser          User?                   @relation("AppointmentSettledBy", fields: [settledByUserId], references: [id], onDelete: SetNull)
  bookingFeedback        BookingFeedback?

  @@unique([id, businessId])
  @@index([businessId])
  @@index([serviceId])
  @@index([staffId, startTime, endTime])
  @@index([startTime])
  @@index([clientId])
  @@index([recurringBookingId])
  @@index([promotionId])
  @@index([bookingDiscountCodeId])
  @@index([storyCampaignId])
  @@index([locationId, startTime, endTime])
  @@index([businessId, status, paymentHoldExpiresAt])
  @@index([settledByUserId])
  @@index([portalOwnerEmail])
}

/// Internal product feedback collected after a widget booking. Superadmin-only.
model BookingFeedback {
  id                    String                @id @default(cuid())
  appointmentId         String                @unique
  businessId            String
  rating                BookingFeedbackRating
  comment               String?
  googleReviewClickedAt DateTime?
  clientPortalAccountId String?
  authenticated         Boolean               @default(false)
  deviceType            String?
  locale                String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  appointment         Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientPortalAccount ClientPortalAccount? @relation(fields: [clientPortalAccountId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([createdAt])
  @@index([rating])
  @@index([googleReviewClickedAt])
  @@index([clientPortalAccountId])
}

/// Durable delivery record for the non-transactional work triggered by a
/// confirmed appointment deposit. The unique appointment key makes the work
/// idempotent across return URLs, webhooks and retry jobs.
model DepositPaymentDelivery {
  id                       String    @id @default(cuid())
  appointmentId            String    @unique
  paymentId                String
  ownerEmailDeliveredAt    DateTime?
  staffEmailDeliveredAt    DateTime?
  customerEmailDeliveredAt DateTime?
  calendarSyncedAt         DateTime?
  attempts                 Int       @default(0)
  lastError                String?
  nextAttemptAt            DateTime  @default(now())
  lockedUntil              DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([nextAttemptAt])
}

model PosPayment {
  id                String            @id @default(cuid())
  businessId        String
  appointmentId     String
  createdByUserId   String?
  channel           PosPaymentChannel @default(QR)
  status            PosPaymentStatus  @default(CREATING)
  amount            Int
  currency          String
  externalReference String            @unique
  idempotencyKey    String            @unique
  providerOrderId   String?           @unique
  providerPaymentId String?
  providerUserId    String?
  qrData            String?           @db.Text
  statusDetail      String?
  expiresAt         DateTime?
  paidAt            DateTime?
  lastSyncedAt      DateTime?
  failureReason     String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdByUser User?       @relation("PosPaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([businessId, status, createdAt])
  @@index([appointmentId, status, createdAt])
  @@index([createdByUserId])
}

model StoryCampaign {
  id               String    @id @default(cuid())
  token            String    @unique
  businessId       String
  createdByUserId  String?
  locationId       String?
  staffId          String?
  serviceIds       String[]  @default([])
  range            String
  targetDate       DateTime? @db.Date
  headline         String
  template         String
  destinationUrl   String    @db.Text
  slotCount        Int       @default(0)
  potentialRevenue Float     @default(0)
  linkVisits       Int       @default(0)
  downloadCount    Int       @default(0)
  shareCount       Int       @default(0)
  copiedCount      Int       @default(0)
  status           String    @default("PUBLISHED")
  objective        String    @default("FILL_SLOTS")
  configuration    Json?
  publishedAt      DateTime?
  archivedAt       DateTime?
  lastVisitedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdByUser User?             @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  location      BusinessLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  staff         Staff?            @relation(fields: [staffId], references: [id], onDelete: SetNull)
  appointments  Appointment[]

  @@index([businessId, createdAt])
  @@index([businessId, status, createdAt])
  @@index([locationId])
  @@index([staffId])
}

model StoryPreset {
  id              String   @id @default(cuid())
  businessId      String
  createdByUserId String?
  name            String
  configuration   Json
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdByUser User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([businessId, name])
  @@index([businessId, isDefault, updatedAt])
  @@index([createdByUserId])
}

model GoogleCalendarConnection {
  id                      String    @id @default(cuid())
  businessId              String
  staffId                 String?
  userId                  String
  scope                   String
  scopeKey                String
  googleEmail             String
  calendarId              String    @default("primary")
  calendarName            String?
  accessTokenEncrypted    String    @db.Text
  refreshTokenEncrypted   String?   @db.Text
  tokenExpiresAt          DateTime?
  syncEnabled             Boolean   @default(true)
  includeCustomerAttendee Boolean   @default(true)
  lastSyncedAt            DateTime?
  lastSyncError           String?   @db.Text
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  business      Business                      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff         Staff?                        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  user          User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  events        GoogleCalendarEvent[]
  readCalendars GoogleCalendarReadSelection[]

  @@unique([businessId, scopeKey])
  @@index([businessId, scope, syncEnabled])
  @@index([staffId, syncEnabled])
  @@index([userId])
}

/// Calendars whose busy intervals are read for public availability.
/// GoogleCalendarConnection.calendarId remains the single write destination.
model GoogleCalendarReadSelection {
  id           String   @id @default(cuid())
  connectionId String
  calendarId   String
  calendarName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  connection GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, calendarId])
  @@index([connectionId])
}

model GoogleCalendarEvent {
  id             String   @id @default(cuid())
  appointmentId  String   @unique
  connectionId   String
  calendarId     String
  googleEventId  String
  googleEventUrl String?
  etag           String?
  lastSyncedAt   DateTime @default(now())
  syncError      String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  appointment Appointment              @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  connection  GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, calendarId, googleEventId])
  @@index([connectionId])
  @@index([lastSyncedAt])
}

// ==========================================
// CRM Ã¢â‚¬â€ CLIENTS
// ==========================================

model Client {
  portalOwnerEmail        String?
  contactFlowConsents     CfConsent[]
  contactFlowSuppressions CfSuppression[]
  contactFlowEnrollments  CfEnrollment[]
  id               String   @id @default(cuid())
  name             String
  email            String
  phone            String?
  rut              String? // RUT del cliente (opcional, configurable por negocio)
  totalSpent       Float    @default(0)
  noShowCount      Int      @default(0)
  currentStamps    Int      @default(0)
  acceptsMarketing Boolean  @default(true)
  privateNotes     String? // Notas privadas del negocio sobre este cliente (CRM light)
  businessId       String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments       Appointment[]
  loyaltyCodes       LoyaltyCode[]
  loyaltyStampEvents LoyaltyStampEvent[]
  recurringBookings  RecurringBooking[]
  productionOrders   ProductionOrder[]

  @@unique([id, businessId])
  @@unique([businessId, email])
  @@index([businessId])
  @@index([portalOwnerEmail])
}

// ==========================================
// LOYALTY / FIDELIZACIÃƒâ€œN
// ==========================================

// Gift Cards keep product definitions, purchases, issued instruments and usage ledgers separate.
model GiftCardTemplate {
  id              String       @id @default(cuid())
  businessId      String
  name            String
  description     String?
  type            GiftCardType
  salePrice       Int
  faceValue       Int?
  currencyCode    String
  isActive        Boolean      @default(true)
  isPublic        Boolean      @default(true)
  position        Int          @default(0)
  designPreset    String       @default("classic")
  backgroundColor String       @default("#FFF5BA")
  accentColor     String       @default("#FF8FAB")
  textColor       String       @default("#111111")
  imageUrl        String?
  shortMessage    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  business  Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services  GiftCardTemplateService[]
  purchases GiftCardPurchase[]
  giftCards GiftCard[]

  @@index([businessId, isActive, isPublic, position])
}

model GiftCardTemplateService {
  id         String @id @default(cuid())
  templateId String
  serviceId  String
  quantity   Int    @default(1)

  template GiftCardTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  service  Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([templateId, serviceId])
  @@index([serviceId])
}

model GiftCardPurchase {
  id                   String                 @id @default(cuid())
  businessId           String
  templateId           String?
  type                 GiftCardType
  paymentMethod        GiftCardPaymentMethod
  paymentStatus        GiftCardPurchaseStatus @default(PENDING)
  salePrice            Int
  currencyCode         String
  templateNameSnapshot String
  templateSnapshot     Json
  buyerName            String
  buyerEmail           String
  deliveryMode         GiftCardDeliveryMode
  recipientName        String?
  recipientEmail       String?
  senderName           String?
  giftMessage          String?
  mpPreferenceId       String?
  mpPaymentId          String?                @unique
  mpStatus             String?
  manualPaymentMethod  String?
  createdById          String?
  paidAt               DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  business  Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  template  GiftCardTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy User?             @relation("GiftCardPurchaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  giftCard  GiftCard?

  @@index([businessId, paymentStatus, createdAt])
  @@index([templateId])
  @@index([mpPreferenceId])
  @@index([createdById])
}

model GiftCard {
  id                      String         @id @default(cuid())
  businessId              String
  purchaseId              String         @unique
  templateId              String?
  publicCode              String         @unique
  claimTokenHash          String         @unique
  type                    GiftCardType
  nameSnapshot            String
  descriptionSnapshot     String?
  currencyCode            String
  salePriceSnapshot       Int
  faceValueSnapshot       Int?
  designPresetSnapshot    String
  backgroundColorSnapshot String
  accentColorSnapshot     String
  textColorSnapshot       String
  imageUrlSnapshot        String?
  shortMessageSnapshot    String?
  initialBalance          Int?
  remainingBalance        Int?
  claimedByAccountId      String?
  claimedAt               DateTime?
  status                  GiftCardStatus @default(ACTIVE)
  voidReason              String?
  deliveryEmailSentAt     DateTime?
  deliveryEmailAttempts   Int            @default(0)
  deliveryEmailLastError  String?
  issuedAt                DateTime       @default(now())
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  business         Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchase         GiftCardPurchase             @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  template         GiftCardTemplate?            @relation(fields: [templateId], references: [id], onDelete: SetNull)
  claimedByAccount ClientPortalAccount?         @relation(fields: [claimedByAccountId], references: [id], onDelete: SetNull)
  entitlements     GiftCardServiceEntitlement[]
  transactions     GiftCardTransaction[]
  redemptions      GiftCardRedemption[]

  @@index([businessId, status])
  @@index([claimedByAccountId, status])
  @@index([templateId])
}

model GiftCardServiceEntitlement {
  id                  String  @id @default(cuid())
  giftCardId          String
  serviceId           String?
  serviceNameSnapshot String
  unitValueSnapshot   Int
  quantityInitial     Int
  quantityRemaining   Int

  giftCard GiftCard                 @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  service  Service?                 @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  items    GiftCardRedemptionItem[]

  @@unique([giftCardId, serviceId])
  @@index([giftCardId])
  @@index([serviceId])
}

model GiftCardRedemption {
  id            String                   @id @default(cuid())
  giftCardId    String
  appointmentId String                   @unique
  amountCovered Int                      @default(0)
  status        GiftCardRedemptionStatus
  createdAt     DateTime                 @default(now())
  committedAt   DateTime?
  releasedAt    DateTime?

  giftCard     GiftCard                 @relation(fields: [giftCardId], references: [id], onDelete: Restrict)
  appointment  Appointment              @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  items        GiftCardRedemptionItem[]
  transactions GiftCardTransaction[]

  @@index([giftCardId, status])
  @@index([status, createdAt])
}

model GiftCardRedemptionItem {
  id                  String @id @default(cuid())
  redemptionId        String
  entitlementId       String
  quantity            Int
  amountCovered       Int    @default(0)
  serviceNameSnapshot String

  redemption  GiftCardRedemption         @relation(fields: [redemptionId], references: [id], onDelete: Cascade)
  entitlement GiftCardServiceEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Restrict)

  @@unique([redemptionId, entitlementId])
  @@index([entitlementId])
}

model GiftCardTransaction {
  id            String                  @id @default(cuid())
  giftCardId    String
  amount        Int
  type          GiftCardTransactionType
  appointmentId String?
  redemptionId  String?
  reason        String?
  createdById   String?
  createdAt     DateTime                @default(now())

  giftCard    GiftCard            @relation(fields: [giftCardId], references: [id], onDelete: Restrict)
  appointment Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  redemption  GiftCardRedemption? @relation(fields: [redemptionId], references: [id], onDelete: SetNull)
  createdBy   User?               @relation("GiftCardTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([giftCardId, createdAt])
  @@index([appointmentId])
  @@index([redemptionId])
  @@index([createdById])
}

model LoyaltyCode {
  id                    String            @id @default(cuid())
  code                  String            @unique
  clientId              String
  businessId            String
  discountType          String // Legacy snapshot kept for existing integrations
  discountValue         Int?
  rewardType            LoyaltyRewardType @default(PERCENTAGE)
  freeServiceId         String?
  rewardName            String?
  isUsed                Boolean           @default(false)
  usedAt                DateTime?
  expiresAt             DateTime?
  redeemedAppointmentId String?           @unique
  createdAt             DateTime          @default(now())

  client              Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  business            Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  freeService         Service?     @relation("LoyaltyCodeFreeService", fields: [freeServiceId], references: [id], onDelete: SetNull)
  redeemedAppointment Appointment? @relation("LoyaltyCodeRedemption", fields: [redeemedAppointmentId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([businessId])
  @@index([freeServiceId])
  @@index([businessId, isUsed, expiresAt])
}

model LoyaltyStampEvent {
  id            String             @id @default(cuid())
  businessId    String
  clientId      String
  appointmentId String?            @unique
  delta         Int
  source        LoyaltyStampSource
  reason        String?
  createdById   String?
  createdAt     DateTime           @default(now())

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("LoyaltyStampEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([clientId, createdAt])
  @@index([createdById])
}

// ==========================================
// AFFILIATES
// ==========================================

model Affiliate {
  id            String   @id @default(cuid())
  referralCode  String   @unique
  businessId    String   @unique
  paidReferrals Int      @default(0)
  spentTokens   Int      @default(0)
  createdAt     DateTime @default(now())

  business           Business   @relation("AffiliateOwner", fields: [businessId], references: [id], onDelete: Cascade)
  referredBusinesses Business[] @relation("ReferredBy")
  prizes             Prize[]

  @@index([referralCode])
}

enum PrizeStatus {
  AVAILABLE
  ACTIVE
  USED
}

model Prize {
  id          String      @id @default(cuid())
  affiliateId String
  type        String // 'PERCENTAGE' | 'FREE_MONTH'
  percentage  Int? // 10, 15, 20, 30, 50
  freeMonths  Int? // 1 or 3
  name        String // "El Fix Rápido", "Modo Dios", etc.
  status      PrizeStatus @default(AVAILABLE)
  createdAt   DateTime    @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([affiliateId, status])
}

// ==========================================
// MARKETING CAMPAIGNS
// ==========================================

model MarketingCampaign {
  id           String   @id @default(cuid())
  businessId   String
  subject      String
  body         String
  audienceSize Int
  sentAt       DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, sentAt])
}

// ==========================================
// AUDIT LOG (WORM: Write Once, Read Many)
// ==========================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String? // JSON stringified payload
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model SystemError {
  id        String   @id @default(cuid())
  source    String
  message   String
  stack     String?
  userId    String?
  details   String? // JSON string
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([source])
}

// Operational Puri telemetry. Never store prompts, tool arguments, tool results,
// response text, or clinical/customer data here.
model PuriRequest {
  id                 String         @id @default(cuid())
  sessionId          String
  businessId         String
  businessLocationId String?
  userId             String
  role               String
  model              String?
  capabilityTier     String         @default("PURI_STANDARD")
  intent             String         @default("unknown")
  status             String         @default("PENDING")
  errorCode          String?
  totalDurationMs    Int?
  modelDurationMs    Int?
  toolsDurationMs    Int?
  promptTokens       Int            @default(0)
  completionTokens   Int            @default(0)
  cachedTokens       Int            @default(0)
  estimatedCostUsd   Float?
  createdAt          DateTime       @default(now())
  completedAt        DateTime?
  toolCalls          PuriToolCall[]
  feedback           PuriFeedback?

  @@index([createdAt])
  @@index([businessId, createdAt])
  @@index([userId, businessId, createdAt])
  @@index([businessLocationId, createdAt])
  @@index([intent, createdAt])
  @@index([status, createdAt])
}

model PuriToolCall {
  id          String      @id @default(cuid())
  requestId   String
  businessId  String
  userId      String
  toolName    String
  status      String
  errorCode   String?
  resultCount Int?
  durationMs  Int
  createdAt   DateTime    @default(now())
  request     PuriRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([toolName, requestId])
  @@index([requestId])
}

model PuriFeedback {
  id         String      @id @default(cuid())
  requestId  String      @unique
  businessId String
  userId     String
  rating     String
  reason     String?
  createdAt  DateTime    @default(now())
  request    PuriRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model PuriUiEvent {
  id                 String   @id @default(cuid())
  event              String
  sessionId          String
  businessId         String
  businessLocationId String?
  userId             String
  role               String
  errorCode          String?
  actionId           String?
  createdAt          DateTime @default(now())

  @@index([event, createdAt])
  @@index([businessId, event, createdAt])
}

// ==========================================
// PRIVACY-SAFE PRODUCT ANALYTICS
// ==========================================

// Events are intentionally decoupled from the user and business relations. This
// keeps the analytics store minimal: it can be aggregated or deleted without
// touching operational records, and no personally identifiable data is required.
model TrackingEvent {
  id                 String    @id @default(cuid())
  event              String
  occurredAt         DateTime  @default(now())
  visitorId          String?
  sessionId          String?
  userId             String?
  businessId         String?
  path               String?
  referrerDomain     String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  properties         Json?
  consentVersion     String?
  consentGrantedAt   DateTime?
  retentionHoldUntil DateTime?
  createdAt          DateTime  @default(now())

  @@index([occurredAt])
  @@index([event, occurredAt])
  @@index([visitorId, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([userId, occurredAt])
  @@index([businessId, event, occurredAt])
}

// Consent records provide server-side evidence of the visitor's analytics choice.
// They intentionally contain only pseudonymous browser identifiers and no form data.
model TrackingConsent {
  id                 String    @id @default(cuid())
  decision           String
  policyVersion      String
  visitorId          String?
  sessionId          String?
  userId             String?
  occurredAt         DateTime  @default(now())
  createdAt          DateTime  @default(now())
  retentionHoldUntil DateTime?

  @@index([occurredAt])
  @@index([visitorId, occurredAt])
  @@index([userId, occurredAt])
}

// Privacy requests are kept in a restricted server-side queue so the team can
// verify identity and meet statutory response deadlines.
model PrivacyRequest {
  id                      String    @id @default(cuid())
  requestType             String
  status                  String    @default("RECEIVED")
  identityStatus          String    @default("PENDING")
  name                    String
  email                   String
  details                 String
  visitorId               String?
  userId                  String?
  dueAt                   DateTime
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  resolvedAt              DateTime?
  resolutionNotes         String?
  responseSentAt          DateTime?
  responseChannel         String?
  responseContent         String?
  initialDueAt            DateTime?
  extensionUsed           Boolean   @default(false)
  extensionNoticeSentAt   DateTime?
  extensionNotes          String?
  acknowledgementSentAt   DateTime?
  acknowledgementError    String?
  adminNotifiedAt         DateTime?
  technicalAction         String?
  technicalActionAt       DateTime?
  technicalActionByUserId String?
  technicalActionEvidence String?
  exportGeneratedAt       DateTime?

  @@index([status, dueAt])
  @@index([email, createdAt])
  @@index([visitorId, createdAt])
}

// Persistent restrictions make opposition, suppression and blocking effective
// across serverless instances. Values derived from email are one-way hashes.
model PrivacyRestriction {
  id              String   @id @default(cuid())
  emailHash       String?
  visitorId       String?
  userId          String?
  scope           String   @default("ANALYTICS")
  reason          String
  sourceRequestId String   @unique
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([emailHash, active])
  @@index([visitorId, active])
  @@index([userId, active])
}

// Shared fixed-window buckets provide rate limiting across Vercel instances.
model ApiRateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// ==========================================
// MARKETPLACE DIRECTORY (admin-curated)
// ==========================================
// Listings are opt-in, unpublished by default, and attached to a physical
// BusinessLocation so multi-branch shops can appear once per sucursal.
// Do not infer category or city from free-text fields.

enum MarketplaceListingStatus {
  PENDING_REVIEW
  ACTIVE
  PAUSED
  EXCLUDED
}

model MarketplaceCategory {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  // Assignable in Admin → Marketplace. Does not imply SEO routes.
  isActive   Boolean  @default(false)
  // Eligible for marketplace SEO paths. Still gated by indexingEnabled.
  seoEnabled Boolean  @default(false)
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  listings MarketplaceListingCategory[]

  @@index([isActive, position])
  @@index([seoEnabled, position])
}

model MarketplaceLocality {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  regionName  String
  communeName String?
  isActive    Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listings MarketplaceListing[]

  @@index([isActive, position])
}

model MarketplaceListing {
  id                         String                   @id @default(cuid())
  businessId                 String
  locationId                 String
  // Operational marketplace state. Independent from subscription/plan.
  // Historical rows stay PENDING_REVIEW until Admin decides.
  status                     MarketplaceListingStatus @default(PENDING_REVIEW)
  // Optional: CL catalog locality. Null for other countries or pending normalization.
  localityId                 String?
  pendingCategoryDescription String?
  pendingLocalityName        String?
  authorizationConfirmedAt   DateTime?
  authorizationConfirmedById String?
  authorizationSource        String?
  authorizationTextVersion   String?
  authorizationRevokedAt     DateTime?
  publishedAt                DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt

  business                 Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location                 BusinessLocation             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locality                 MarketplaceLocality?         @relation(fields: [localityId], references: [id], onDelete: Restrict)
  authorizationConfirmedBy User?                        @relation("MarketplaceListingAuthorizedBy", fields: [authorizationConfirmedById], references: [id], onDelete: SetNull)
  categories               MarketplaceListingCategory[]

  @@unique([businessId, locationId])
  @@index([publishedAt, localityId])
  @@index([status, publishedAt])
  @@index([businessId])
  @@index([locationId])
  @@index([authorizationConfirmedById])
  @@index([authorizationRevokedAt])
}

model MarketplaceListingCategory {
  listingId  String
  categoryId String
  createdAt  DateTime @default(now())

  listing  MarketplaceListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  category MarketplaceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([listingId, categoryId])
  @@index([categoryId, listingId])
}

// MCP credentials are random opaque values; only SHA-256 digests are stored.
model McpRolloutState {
  id                    String    @id
  businessAccessEnabled Boolean   @default(false)
  approvalReference     String?
  approvedAt            DateTime?
  version               Int       @default(0)
  updatedAt             DateTime  @updatedAt
}

model McpOAuthClient {
  id           String            @id @default(uuid())
  name         String
  redirectUris String[]
  createdAt    DateTime          @default(now())
  requests     McpOAuthRequest[]
  connections  McpConnection[]
}

model McpOAuthRequest {
  id          String         @id @default(uuid())
  clientId    String
  redirectUri String
  scopes      String[]
  state       String
  challenge   String
  resource    String
  csrfHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  client      McpOAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([clientId])
}

model McpProfile {
  id          String          @id @default(uuid())
  userId      String
  businessId  String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  connections McpConnection[]

  @@unique([userId, businessId])
  @@index([businessId])
}

model McpConnection {
  id           String          @id @default(uuid())
  profileId    String
  clientId     String
  scopes       String[]
  tokenVersion Int
  createdAt    DateTime        @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  profile      McpProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  client       McpOAuthClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  codes        McpOAuthCode[]
  tokens       McpOAuthToken[]
  operations   McpOperation[]

  @@index([profileId, revokedAt])
  @@index([clientId])
  @@index([expiresAt])
}

model McpOAuthCode {
  hash         String        @id
  connectionId String
  redirectUri  String
  challenge    String
  expiresAt    DateTime
  consumedAt   DateTime?
  connection   McpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([connectionId])
}

model McpOAuthToken {
  id               String        @id @default(uuid())
  connectionId     String
  accessHash       String        @unique
  refreshHash      String        @unique
  issuer           String
  resource         String
  scopes           String[]
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  refreshUsedAt    DateTime?
  connection       McpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
}

model McpOperation {
  id               String         @id @default(uuid())
  requestKey       String         @unique
  tokenHash        String         @unique
  connectionId     String?
  businessId       String
  kind             String
  encryptedPayload String
  snapshotHash     String
  state            String         @default("PREPARED")
  result           Json?
  expiresAt        DateTime
  createdAt        DateTime       @default(now())
  approvedAt       DateTime?
  connection       McpConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  business         Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([connectionId])
  @@index([businessId])
}

// Sandbox-only external operations. Intent, provider response and payment are
// separate records; an accepted HTTP request never grants entitlements.
model CommercialBillingOperation {
  id                       String @id @default(cuid())
  businessId               String
  subscriptionId           String
  seatChangeRequestId      String? @unique
  provider                 CommercialBillingProvider
  environment              String @default("SANDBOX")
  kind                     String
  strategy                 String
  status                   String @default("PREPARED")
  idempotencyKey           String @unique
  inputHash                String
  previousContractHash     String
  targetPlanCode           String
  targetProfessionalTotal  Int
  quoteSnapshot            Json
  providerPreview          Json?
  recurringAmountMinor     Int
  expectedPaymentMinor     Int?
  taxAmountMinor           Int?
  currencyCode             String @default("CLP")
  effectiveAt              DateTime
  providerSubscriptionId   String?
  providerOperationId      String?
  executionStartedAt       DateTime?
  appliedAt                DateTime?
  failureCode              String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription CommercialSubscription @relation(fields: [subscriptionId, businessId], references: [id, businessId], onDelete: Cascade)
  seatChangeRequest SeatChangeRequest? @relation(fields: [seatChangeRequestId], references: [id], onDelete: NoAction)
  payments CommercialPaymentEvidence[]

  @@unique([id, businessId])
  @@index([businessId, status, effectiveAt])
  @@index([provider, providerSubscriptionId])
  @@index([provider, environment, updatedAt, id], map: "CommercialBillingOperation_recovery_idx")
}

model CommercialPaymentEvidence {
  id                      String @id @default(cuid())
  businessId              String
  operationId             String
  provider                CommercialBillingProvider
  paymentId               String
  status                  String
  origin                  String
  amountMinor             Int
  currencyCode            String
  periodStart             DateTime
  periodEnd               DateTime
  occurredAt              DateTime
  providerSubscriptionId  String
  eventId                 String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  operation CommercialBillingOperation @relation(fields: [operationId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([provider, paymentId])
  @@index([operationId, status])
}

// Immutable proposal payload; mutable workflow and verified evidence are separate.
// These records have no production writer or public Data API policy.
model CommercialMigrationProposal {
  id                String @id @default(cuid())
  businessId        String
  subscriptionId    String
  createdById       String
  idempotencyKey    String @unique
  inputHash         String
  sourceFingerprint String
  previewHash       String
  preview           Json
  targetPlanCode    String
  professionalTotal Int
  provider          CommercialBillingProvider
  effectiveAt       DateTime
  expiresAt         DateTime
  status            String @default("AWAITING_APPROVAL")
  approvedById      String?
  approvedAt        DateTime?
  appliedAt         DateTime?
  reason            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription      CommercialSubscription @relation(fields: [subscriptionId, businessId], references: [id, businessId], onDelete: Cascade)
  websiteTransition CommercialWebsiteTransition?
  evidence          CommercialMigrationEvidence[]

  @@unique([id, businessId])
  @@index([subscriptionId, businessId])
  @@index([businessId, status, effectiveAt])
}

model CommercialWebsiteTransition {
  id                    String @id @default(cuid())
  proposalId            String @unique
  businessId            String
  addonId               String?
  provider              String?
  externalSubscriptionId String?
  status                String
  paidUntil             DateTime?
  cancellationObservedAt DateTime?
  lastResourceAt        DateTime?
  origin                String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  proposal              CommercialMigrationProposal @relation(fields: [proposalId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([proposalId, businessId])
  @@index([businessId, status])
}

model CommercialMigrationEvidence {
  id                     String @id @default(cuid())
  proposalId             String
  businessId             String
  provider               CommercialBillingProvider
  eventId                String
  payloadHash            String
  origin                 String
  state                  String
  paymentId              String?
  amountMinor            Int?
  currencyCode           String
  providerSubscriptionId String
  periodStart            DateTime?
  periodEnd              DateTime?
  resourceUpdatedAt      DateTime
  createdAt              DateTime @default(now())
  proposal               CommercialMigrationProposal @relation(fields: [proposalId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([provider, eventId])
  @@unique([provider, paymentId])
  @@index([proposalId, businessId, state])
}

// Puri+ remains local-only. Evidence is aggregate data, never customer lists or prompts.
// Contact Flow is private server-only infrastructure. Public SQL roles have no grants.
model CfPolicy {
  key          String    @id
  businessId   String?
  killed       Boolean   @default(true)
  emailEnabled Boolean   @default(false)
  dailyLimit   Int
  monthlyLimit Int
  contactDays  Int
  senderEmail  String
  updatedAt    DateTime  @updatedAt
  business     Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model CfCampaign {
  staff Staff? @relation(fields: [staffId,businessId],references:[id,businessId],onDelete:Restrict)
  id               String                   @id @default(cuid())
  businessId       String
  scopeKey         String
  locationId       String?
  staffId          String?
  recommendationId String
  currentVersion   Int                      @default(1)
  status           String                   @default("DRAFT")
  createdById      String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  business         Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location         BusinessLocation?        @relation(fields: [locationId, businessId], references: [id, businessId], onDelete: Restrict)
  recommendation   PuriGrowthRecommendation @relation(fields: [recommendationId, businessId, scopeKey], references: [id, businessId, scopeKey], onDelete: Restrict)
  versions         CfVersion[]
  audits           CfAudit[]

  @@unique([id, businessId])
  @@unique([businessId, scopeKey, recommendationId])
  @@index([businessId, scopeKey, status, createdAt])
}

model CfVersion {
  timezone String
  businessAddress String
  senderEmail String
  id                    String            @id @default(cuid())
  campaignId            String
  businessId            String
  version               Int
  recommendationVersion Int
  recommendationHash    String
  evidenceHash          String
  evidence              Json
  rules                 Json
  objective             String
  channel               String            @default("EMAIL")
  purpose               String            @default("COMMERCIAL")
  template              String
  serviceId             String
  serviceName           String
  servicePrice          Float
  businessName          String
  businessSlug          String
  currencyCode          String
  subject               String
  body                  String
  cohortHash            String
  contentHash           String
  startsAt              DateTime
  expiresAt             DateTime
  maxContacts           Int
  dailyLimit            Int
  createdAt             DateTime          @default(now())
  campaign              CfCampaign        @relation(fields: [campaignId, businessId], references: [id, businessId], onDelete: Cascade)
  service               Service           @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: Restrict)
  authorizations        CfAuthorization[]
  enrollments           CfEnrollment[]

  @@unique([id, businessId])
  @@unique([campaignId, version])
  @@index([businessId, expiresAt])
}

model CfAuthorization {
  id          String    @id @default(cuid())
  businessId  String
  versionId   String
  actorId     String
  contentHash String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  version     CfVersion @relation(fields: [versionId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([businessId, versionId, revokedAt])
}

model CfConsent {
  acceptedText String
  evidenceSignature String
  recordedById String
  id           String         @id @default(cuid())
  businessId   String
  clientId     String
  addressHash  String
  purpose      String         @default("COMMERCIAL")
  channel      String         @default("EMAIL")
  source       String
  textVersion  String
  evidenceRef  String
  evidenceHash String
  grantedAt    DateTime
  state        String         @default("GRANTED")
  revokedAt    DateTime?
  createdAt    DateTime       @default(now())
  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client       Client         @relation(fields: [clientId, businessId], references: [id, businessId], onDelete: Restrict)
  enrollments  CfEnrollment[]

  @@unique([id, businessId])
  @@unique([businessId, evidenceRef])
  @@index([businessId, clientId, channel, purpose, state])
}

model CfSuppression {
  id          String   @id @default(cuid())
  businessId  String
  clientId    String
  addressHash String
  purpose     String
  channel     String
  reason      String
  sourceRef   String
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client      Client   @relation(fields: [clientId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, sourceRef])
  @@index([businessId, clientId, channel, purpose])
  @@index([businessId, addressHash, channel, purpose])
}

model CfEnrollment {
  id          String         @id @default(cuid())
  businessId  String
  versionId   String
  clientId    String
  addressHash String
  consentId   String?
  eligible    Boolean
  exclusion   String?
  createdAt   DateTime       @default(now())
  version     CfVersion      @relation(fields: [versionId, businessId], references: [id, businessId], onDelete: Cascade)
  client      Client         @relation(fields: [clientId, businessId], references: [id, businessId], onDelete: Restrict)
  consent     CfConsent?     @relation(fields: [consentId, businessId], references: [id, businessId], onDelete: Restrict)
  message     CfMessage?
  tokens      CfToken[]
  attribution CfAttribution?

  @@unique([id, businessId])
  @@unique([versionId, clientId])
  @@index([businessId, clientId, createdAt])
}

model CfMessage {
  id             String              @id @default(cuid())
  businessId     String
  enrollmentId   String              @unique
  idempotencyKey String              @unique
  state          String              @default("QUEUED")
  provider       String              @default("SIMULATED")
  providerId     String?             @unique
  simulation     String              @default("SUCCESS")
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime            @default(now())
  enrollment     CfEnrollment        @relation(fields: [enrollmentId, businessId], references: [id, businessId], onDelete: Cascade)
  outbox         CfOutbox?
  attempts       CfAttempt[]
  events         CfProviderEvent[]
  reservation    CfQuotaReservation?
  receipt        CfSimulatedReceipt?

  @@unique([enrollmentId, businessId])
  @@unique([id, businessId])
  @@index([businessId, state, createdAt])
}

model CfOutbox {
  id             String    @id @default(cuid())
  businessId     String
  messageId      String    @unique
  state          String    @default("PENDING")
  nextAttemptAt  DateTime  @default(now())
  leaseUntil     DateTime?
  leaseOwner     String?
  fence          Int       @default(0)
  attempts       Int       @default(0)
  firstAttemptAt DateTime?
  lastError      String?
  message        CfMessage @relation(fields: [messageId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([messageId, businessId])
  @@index([state, nextAttemptAt, leaseUntil])
  @@index([businessId, state])
}

model CfAttempt {
  id         String    @id @default(cuid())
  businessId String
  messageId  String
  number     Int
  fence      Int
  outcome    String
  code       String?
  createdAt  DateTime  @default(now())
  message    CfMessage @relation(fields: [messageId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([messageId, number])
  @@index([businessId, createdAt])
}

model CfSimulatedReceipt {
  id             String    @id @default(cuid())
  businessId     String
  messageId      String    @unique
  idempotencyKey String    @unique
  providerId     String    @unique
  createdAt      DateTime  @default(now())
  message        CfMessage @relation(fields: [messageId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([messageId, businessId])
}

model CfProviderEvent {
  id          String    @id
  businessId  String
  messageId   String
  provider    String
  providerId  String
  kind        String
  payloadHash String
  occurredAt  DateTime
  receivedAt  DateTime  @default(now())
  message     CfMessage @relation(fields: [messageId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([businessId, messageId, occurredAt])
}

model CfQuotaBucket {
  key         String              @id
  businessId  String?
  kind        String
  period      String
  limit       Int
  reserved    Int                 @default(0)
  consumed    Int                 @default(0)
  allocations CfQuotaAllocation[]
}

model CfQuotaReservation {
  id          String              @id @default(cuid())
  businessId  String
  messageId   String              @unique
  state       String              @default("RESERVED")
  createdAt   DateTime            @default(now())
  settledAt   DateTime?
  message     CfMessage           @relation(fields: [messageId, businessId], references: [id, businessId], onDelete: Cascade)
  allocations CfQuotaAllocation[]

  @@unique([messageId, businessId])
}

model CfQuotaAllocation {
  reservationId String
  bucketKey     String
  reservation   CfQuotaReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  bucket        CfQuotaBucket      @relation(fields: [bucketKey], references: [key], onDelete: Restrict)

  @@id([reservationId, bucketKey])
}

model CfToken {
  id           String       @id
  businessId   String
  enrollmentId String
  kind         String
  expiresAt    DateTime
  usedAt       DateTime?
  enrollment   CfEnrollment @relation(fields: [enrollmentId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([enrollmentId, kind])
  @@index([expiresAt])
}

model CfAttribution {
  id            String       @id @default(cuid())
  businessId    String
  enrollmentId  String       @unique
  appointmentId String       @unique
  tokenHash     String
  createdAt     DateTime     @default(now())
  enrollment    CfEnrollment @relation(fields: [enrollmentId, businessId], references: [id, businessId], onDelete: Restrict)
  appointment   Appointment  @relation(fields: [appointmentId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([enrollmentId, businessId])
  @@unique([appointmentId, businessId])
  @@index([businessId, createdAt])
}

model CfAudit {
  id         String      @id @default(cuid())
  businessId String
  campaignId String?
  actorId    String?
  event      String
  key        String      @unique
  details    Json?
  createdAt  DateTime    @default(now())
  campaign   CfCampaign? @relation(fields: [campaignId, businessId], references: [id, businessId], onDelete: Cascade)
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

model PuriGrowthPolicy {
  businessId        String @id
  proactiveEnabled  Boolean @default(false)
  everyHours        Int @default(24)
  rules             Json
  updatedAt         DateTime @updatedAt
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model PuriGrowthRun {
  id              String @id @default(cuid())
  businessId      String
  scopeKey        String
  locationId      String?
  staffId         String?
  analysisKey     String @unique
  kind            String
  ruleVersion     String
  periodStart     DateTime
  periodEnd       DateTime
  status          String @default("RUNNING")
  leaseToken      String
  leaseUntil      DateTime
  attempts        Int @default(1)
  evidence        Json?
  evidenceHash    String?
  durationMs      Int?
  cacheHits       Int @default(0)
  proactiveCheckedAt DateTime?
  errorCode       String?
  createdAt       DateTime @default(now())
  completedAt     DateTime?
  expiresAt       DateTime
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  signals         PuriGrowthSignal[]

  @@unique([id, businessId, scopeKey])
  @@index([businessId, scopeKey, status, periodEnd])
  @@index([status, leaseUntil])
  @@index([businessId, scopeKey, proactiveCheckedAt])
  @@index([expiresAt])
}

model PuriGrowthSignal {
  id              String @id @default(cuid())
  businessId      String
  scopeKey        String
  runId           String
  kind            String
  ruleVersion     String
  evidenceHash    String
  materialHash    String
  dedupeKey       String @unique
  evidence        Json
  confidence      String
  priority        Int
  status          String @default("DETECTED")
  suppressedUntil DateTime?
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  run             PuriGrowthRun @relation(fields: [runId, businessId, scopeKey], references: [id, businessId, scopeKey], onDelete: Cascade)
  recommendations PuriGrowthRecommendation[]

  @@unique([id, businessId, scopeKey])
  @@index([businessId, scopeKey, kind, materialHash])
  @@index([businessId, scopeKey, status, expiresAt])
  @@index([runId, businessId, scopeKey])
  @@index([expiresAt])
}

model PuriGrowthRecommendation {
  contactFlowCampaigns CfCampaign[]
  id                  String @id @default(cuid())
  businessId          String
  scopeKey            String
  signalId            String
  version             Int @default(1)
  status              String @default("DRAFT")
  dedupeKey           String @unique
  title               String
  explanation         String
  evidenceHash        String
  evidence            Json
  strategy            Json?
  contentHash         String
  ruleVersion         String
  model               String?
  inputTokens         Int?
  outputTokens        Int?
  cachedTokens        Int?
  costMicros          Int?
  costKnown           Boolean @default(false)
  generation          String @default("DETERMINISTIC")
  approvedById        String?
  approvedAt          DateTime?
  approvedContentHash String?
  rejectedById        String?
  rejectedAt          DateTime?
  executable          Boolean @default(false)
  createdAt           DateTime @default(now())
  expiresAt           DateTime
  signal              PuriGrowthSignal @relation(fields: [signalId, businessId, scopeKey], references: [id, businessId, scopeKey], onDelete: Cascade)
  audits              PuriGrowthAudit[]

  @@unique([id, businessId, scopeKey])
  @@index([businessId, scopeKey, status, createdAt])
  @@index([signalId, businessId, scopeKey])
  @@index([expiresAt])
}

model PuriBudgetBucket {
  key             String @id
  businessId      String?
  category        String
  periodStart     DateTime @db.Date
  limitMicros     Int
  limitUnits      Int
  reservedMicros  Int @default(0)
  spentMicros     Int @default(0)
  reservedUnits   Int @default(0)
  spentUnits      Int @default(0)
  unknownCost     Boolean @default(false)
  alertLevel      Int @default(0)
  updatedAt       DateTime @updatedAt
  business        Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, category, periodStart])
  @@index([periodStart])
}

model PuriUsageReservation {
  id               String @id @default(cuid())
  businessId       String
  idempotencyKey   String @unique
  inputHash        String
  category         String
  bucketKeys       String[]
  reservedMicros   Int
  reservedUnits    Int
  actualMicros     Int?
  inputTokens      Int?
  outputTokens     Int?
  cachedTokens     Int?
  cacheWriteTokens Int?
  model            String?
  state            String @default("RESERVED")
  errorCode        String?
  createdAt        DateTime @default(now())
  settledAt        DateTime?
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, category, createdAt])
  @@index([state, createdAt])
}

model PuriGrowthAudit {
  id               String @id @default(cuid())
  businessId       String
  scopeKey         String
  recommendationId String?
  event            String
  actorId          String?
  dedupeKey        String @unique
  details          Json?
  createdAt        DateTime @default(now())
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recommendation   PuriGrowthRecommendation? @relation(fields: [recommendationId, businessId, scopeKey], references: [id, businessId, scopeKey], onDelete: Cascade)

  @@index([businessId, event, createdAt])
  @@index([recommendationId, businessId, scopeKey])
  @@index([createdAt])
}

// Global scheduler lease/cursor. Contains counts and error codes, never payloads.
model CommercialWorkerState {
  key           String   @id
  leaseOwner    String?
  leaseUntil    DateTime?
  fence         Int      @default(0)
  cursor        String   @default("")
  lastStartedAt DateTime?
  lastSuccessAt DateTime?
  lastError     String?
  summary       Json?
  updatedAt     DateTime @updatedAt
}
