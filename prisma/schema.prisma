generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Public booking keys are scoped by business; hashes contain no customer data.
model BookingOperation {
  id            String    @id @default(cuid())
  businessId    String
  keyHash       String
  payloadHash   String
  ownerToken    String
  leaseUntil    DateTime
  expiresAt     DateTime
  appointmentId String?   @unique
  response      Json?
  httpStatus    Int?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, keyHash])
  @@index([expiresAt])
}

enum WebsiteStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

enum WebsiteDomainStatus {
  PENDING
  VERIFIED
  ACTIVE
  FAILED
}

enum DomainRequestStatus {
  REQUESTED
  REVIEWING
  QUOTED
  COMPLETED
  CANCELLED
}

model BusinessWebsite {
  id                       String          @id @default(cuid())
  businessId               String          @unique
  templateKey              String          @default("bella")
  templateVersion          Int             @default(1)
  status                   WebsiteStatus   @default(DRAFT)
  subdomain                String          @unique
  draftConfig              Json
  publishedConfig          Json?
  templateConfigs          Json            @default("{}")
  publishedTemplateKey     String?
  publishedTemplateVersion Int?
  revision                 Int             @default(0)
  publishedRevision        Int?
  publishedAt              DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  business                 Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  domains                  WebsiteDomain[]
  domainRequests           DomainRequest[]
  media                    WebsiteMedia[]
}

model WebsiteMedia {
  id        String          @id @default(cuid())
  websiteId String
  publicId  String          @unique
  secureUrl String          @unique
  width     Int
  height    Int
  format    String
  bytes     Int
  usage     String
  provider  String          @default("cloudinary")
  deletedAt DateTime?
  createdAt DateTime        @default(now())
  website   BusinessWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, deletedAt])
}

model WebsiteDomain {
  id                String              @id @default(cuid())
  websiteId         String
  hostname          String              @unique
  status            WebsiteDomainStatus @default(PENDING)
  verificationToken String
  tenantVerifiedAt  DateTime?
  isPrimary         Boolean             @default(false)
  verifiedAt        DateTime?
  activatedAt       DateTime?
  lastError         String?
  provider          String              @default("pending")
  dnsRecords        Json                @default("[]")
  checkedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  website           BusinessWebsite     @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, status])
}

model DomainRequest {
  id        String              @id @default(cuid())
  websiteId String
  hostname  String
  notes     String              @default("")
  status    DomainRequestStatus @default(REQUESTED)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  website   BusinessWebsite     @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, status])
}

// Independent recurring item: supports Chilean MP base plans and annual base plans
// without replacing or cancelling any existing subscription.
model WebsiteAddon {
  id                    String                     @id @default(cuid())
  businessId            String                     @unique
  status                SubscriptionStatus         @default(INACTIVE)
  provider              String                     @default("paddle")
  paddleSubscriptionId  String?                    @unique
  paddleCustomerId      String?
  paddlePriceId         String?
  checkoutTransactionId String?
  mpSubscriptionId      String?                    @unique
  mpCustomerId          String?
  checkoutOperations    WebsiteCheckoutOperation[]
  validUntil            DateTime?
  cancelAt              DateTime?
  lastEventAt           DateTime?
  lastEventId           String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  business              Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// Durable server-created ownership proof. Unknown provider create outcomes are
// reconciled by reference before retrying; never silently create another agreement.
model WebsiteCheckoutOperation {
  id               String           @id
  addonId          String
  provider         String           @default("mercadopago")
  priceTier        WebsitePriceTier
  amount           Int
  currency         String           @default("CLP")
  firstChargeAt    DateTime?
  state            String           @default("CREATING")
  mpSubscriptionId String?          @unique
  checkoutUrl      String?
  providerStatus   String?
  expiresAt        DateTime
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  addon            WebsiteAddon     @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@index([addonId, createdAt])
}

model WebsiteBillingEvent {
  eventId   String   @id
  createdAt DateTime @default(now())
}

enum WebsitePriceTier {
  STANDARD
  BETA_FOUNDER
}

// Sealed once at launch. Eligibility is never recalculated by the application.
model WebsiteLaunchSnapshot {
  id          String                    @id
  launchAt    DateTime                  @unique
  capturedAt  DateTime
  memberCount Int
  members     WebsiteOfferEligibility[]
}

// Lifetime commercial promise belongs to businessId, independent of WebsiteAddon.
// priceTier / grandfathered / betaEligible are derived from offerCode.
model WebsiteOfferEligibility {
  businessId      String                @id
  offerCode       WebsitePriceTier      @default(BETA_FOUNDER)
  snapshotId      String
  eligibleAt      DateTime
  trialStartedAt  DateTime?
  trialEndsAt     DateTime?
  trialConsumedAt DateTime?
  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  snapshot        WebsiteLaunchSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
}

// First-party commercial audit, without email, owner, hostname or payment details.
model WebsiteCommercialEvent {
  key        String           @id
  businessId String
  event      String
  priceTier  WebsitePriceTier
  occurredAt DateTime         @default(now())
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([event, occurredAt])
}

// ==========================================
// AUTH & USERS
// ==========================================

enum UserRole {
  ADMIN
  RECEPTIONIST
  STAFF
  SUPERADMIN
}

enum ClientPortalTokenPurpose {
  MAGIC_ACCESS
  VERIFY_ACCOUNT
  RESET_PASSWORD
}

enum ServiceAvailabilityType {
  NORMAL
  SPECIAL
}

enum WidgetPromoPlacement {
  HEADER
  BETWEEN_SERVICES
  FOOTER
}

enum LoyaltyRewardType {
  PERCENTAGE
  FIXED
  FREE_SERVICE
  CUSTOM
}

enum LoyaltyStampSource {
  APPOINTMENT
  MANUAL
  ADJUSTMENT
}

enum GiftCardType {
  BALANCE
  SERVICE
}

enum GiftCardPaymentMethod {
  MERCADOPAGO
  MANUAL
}

enum GiftCardPurchaseStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  MANUAL_PAID
}

enum GiftCardDeliveryMode {
  SELF
  GIFT
}

enum GiftCardStatus {
  ACTIVE
  DEPLETED
  VOIDED
  REFUNDED
  EXPIRED
}

enum GiftCardTransactionType {
  ISSUED
  REDEEMED
  RELEASED
  ADJUSTMENT
  VOID
  REFUND
}

enum GiftCardRedemptionStatus {
  RESERVED
  COMMITTED
  RELEASED
}

enum BookingFeedbackRating {
  POSITIVE
  IMPROVE
}

model User {
  mcpProfiles     McpProfile[]
  id              String       @id @default(cuid())
  email           String       @unique
  password        String
  name            String
  role            UserRole     @default(ADMIN)
  isSuperAdmin    Boolean      @default(false)
  trialUsedAt     DateTime?
  registrationIp  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  tokenVersion    Int          @default(1)
  deletedAt       DateTime?
  termsAcceptedAt DateTime?

  businesses                  Business[]
  staff                       Staff[]
  auditLogs                   AuditLog[]
  adminLoginCodes             AdminLoginCode[]
  platformDiscountCodes       PlatformDiscountCode[]     @relation("PlatformDiscountCreatedBy")
  adminInteractiveCampaigns   AdminInteractiveCampaign[] @relation("AdminInteractiveCampaignCreatedBy")
  googleCalendarConnections   GoogleCalendarConnection[]
  storyCampaigns              StoryCampaign[]
  storyPresets                StoryPreset[]
  posPaymentsCreated          PosPayment[]               @relation("PosPaymentCreatedBy")
  settledAppointments         Appointment[]              @relation("AppointmentSettledBy")
  marketplaceAuthorizations   MarketplaceListing[]       @relation("MarketplaceListingAuthorizedBy")
  superAdminSessions          SuperAdminSession[]
  loyaltyStampEventsCreated   LoyaltyStampEvent[]        @relation("LoyaltyStampEventCreatedBy")
  giftCardPurchasesCreated    GiftCardPurchase[]         @relation("GiftCardPurchaseCreatedBy")
  giftCardTransactionsCreated GiftCardTransaction[]      @relation("GiftCardTransactionCreatedBy")
}

// ==========================================
// PASSWORD RESET
// ==========================================

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model ClientPortalToken {
  id         String                   @id @default(cuid())
  email      String
  tokenHash  String                   @unique
  expiresAt  DateTime
  consumedAt DateTime?
  purpose    ClientPortalTokenPurpose @default(MAGIC_ACCESS)
  createdAt  DateTime                 @default(now())
  authenticationIntent Boolean                  @default(false)

  @@index([email, createdAt])
  @@index([expiresAt])
}

model ClientPortalAccount {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  phone           String?
  rut             String?
  defaultAddress  String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions         ClientPortalSession[]
  giftCards        GiftCard[]
  bookingFeedbacks BookingFeedback[]

  @@index([emailVerifiedAt])
}

model ClientPortalSession {
  id         String   @id @default(cuid())
  accountId  String
  email      String?
  tokenHash  String   @unique
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  account ClientPortalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
  @@index([expiresAt])
  @@index([email])
}

model ClientPortalIdentity {
  email               String    @id
  legacyInvalidBefore DateTime?
}

model ClientPortalRevocation {
  tokenHash String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

model AdminLoginCode {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model SuperAdminSession {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  lastUsedAt     DateTime  @default(now())
  lastAuthAt     DateTime  @default(now())
  revokedAt      DateTime?
  userAgent      String?
  rememberDevice Boolean   @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// ==========================================
// ANTI-FRAUD
// ==========================================

model BlacklistedIp {
  id        String   @id @default(cuid())
  ip        String   @unique
  reason    String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([ip])
}

// ==========================================
// SUBSCRIPTIONS
// ==========================================

enum SubscriptionPlan {
  PURAGENDA
  PURAGENDA_PLUS
  INDIVIDUAL
  EQUIPO
  TEST
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  INACTIVE
  CANCELLED
}

// Puragenda Next commercial state is additive to the legacy Subscription
// enums. It is intentionally kept separate so existing checkout and dunning
// paths can continue using their current contracts until cutover.
enum CommercialSubscriptionStatus {
  DRAFT
  PENDING_PAYMENT
  ACTIVE
  TRIALING
  PAST_DUE_GRACE
  PAST_DUE_BLOCKED
  SCHEDULED_CHANGE
  INACTIVE
  CANCELLED
  UNKNOWN
}

enum CommercialBillingProvider {
  NONE
  MERCADO_PAGO
  PADDLE
  BANK_TRANSFER
  MANUAL
}

enum CommercialSubscriptionItemKind {
  BASE_PLAN
  PROFESSIONAL_SEATS
  LEGACY_ADDON
  BENEFIT
}

enum CommercialEntitlementStatus {
  ACTIVE
  SCHEDULED
  EXPIRED
  REVOKED
  UNKNOWN
}

enum CommercialEventOutcome {
  RECEIVED
  APPLIED
  IGNORED
  REJECTED
  UNKNOWN
}

enum SeatChangeRequestStatus {
  DRAFT
  PENDING_PAYMENT
  SCHEDULED
  APPLIED
  CANCELLED
  REJECTED
  UNKNOWN
}

enum SeatChangeKind {
  INCREASE
  DECREASE
}

enum SubscriptionPaymentNotificationStatus {
  PENDING
  SENT
  FAILED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionPaymentMethod {
  AUTOMATIC
  BANK_TRANSFER
}

enum RecurringMode {
  FIXED_DAYS // El negocio fija exactamente que dias (ej: L/M/V)
  DAYS_WITH_REST // N dias/semana con minimo de descanso entre sesiones
  FREE_MINIMUM // Libre con minimo de dias semanales, cliente elige
}

enum RecurringStatus {
  PENDING_APPROVAL // Esperando que el negocio apruebe
  ACTIVE // Corriendo normalmente
  PAUSED // Pausada temporalmente
  CANCELLED // Cancelada por el negocio o el cliente
  COMPLETED // Termino el periodo natural
}

enum DepositPaymentMode {
  MERCADOPAGO
  MANUAL_LINK
}

enum BookingDiscountType {
  PERCENTAGE
  FIXED
}

model Subscription {
  id                           String                    @id @default(cuid())
  plan                         SubscriptionPlan          @default(INDIVIDUAL)
  status                       SubscriptionStatus        @default(ACTIVE)
  billingCycle                 BillingCycle              @default(MONTHLY)
  isTrial                      Boolean                   @default(false)
  trialEndsAt                  DateTime?
  extraStaffCount              Int                       @default(0)
  // Absolute active-professional cap; purchased extras do not increase it.
  staffLimitOverride           Int?
  paymentMethod                SubscriptionPaymentMethod @default(AUTOMATIC)
  // Agreed manual monthly price in CLP, VAT included; never sent to a provider.
  customMonthlyPriceClp        Int?
  pendingDiscountPercentage    Int?
  hasCountedAsPaidReferral     Boolean                   @default(false)
  trialWarningEmailSent        Boolean                   @default(false)
  freeMonthsRemaining          Int                       @default(0)
  activePrizeId                String?
  promoName                    String?
  promoFreeMonthsRemaining     Int                       @default(0)
  promoDiscountPercentage      Int?
  promoDiscountMonthsRemaining Int                       @default(0)
  nextBillingOverrideAmount    Int?
  billingNotes                 String?
  lastBillingSyncAt            DateTime?
  lastBillingSyncError         String?
  businessId                   String                    @unique
  mpCustomerId                 String?
  mpSubscriptionId             String?
  paddleCustomerId             String?                   @unique
  paddleSubscriptionId         String?                   @unique
  paddlePriceIds               String[]                  @default([])
  paddleLastEventAt            DateTime?
  paddleLastEventId            String?
  currentPeriodEnd             DateTime?
  paymentFailedAt              DateTime?
  gracePeriodEndsAt            DateTime?
  nextPaymentAttemptAt         DateTime?
  lastInvoiceId                String?
  lastInvoiceStatus            String?
  lastPaymentId                String?
  lastPaymentStatus            String?
  lastPaymentStatusDetail      String?
  lastPaymentAttemptAt         DateTime?
  paymentRetryCount            Int                       @default(0)
  dunningEmailSentAt           DateTime?
  graceExpiryWarningSentAt     DateTime?
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt

  business                    Business                          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platformDiscountRedemptions PlatformDiscountRedemption[]
  paymentNotifications        SubscriptionPaymentNotification[]
  commercialSnapshots         CommercialSubscription[]          @relation("LegacyCommercialSubscription")

  @@index([status, gracePeriodEndsAt])
}

model SubscriptionPaymentNotification {
  id             String                                @id @default(cuid())
  subscriptionId String
  provider       String
  paymentId      String
  invoiceId      String?
  status         SubscriptionPaymentNotificationStatus @default(PENDING)
  claimedAt      DateTime                              @default(now())
  sentAt         DateTime?
  failedAt       DateTime?
  createdAt      DateTime                              @default(now())
  updatedAt      DateTime                              @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([provider, paymentId])
  @@index([subscriptionId])
  @@index([status, failedAt])
}

// Current commercial contract snapshot. This is deliberately additive to
// Subscription: legacy billing remains the operational source until a later
// migration and cutover explicitly changes it.
model CommercialSubscription {
  id                     String                       @id @default(cuid())
  businessId             String                       @unique
  legacySubscriptionId   String?                      @unique
  catalogVersion         String
  planCode               String
  legacyPlanCode         String?
  currencyCode           String                       @default("CLP")
  billingCycle           BillingCycle
  status                 CommercialSubscriptionStatus @default(DRAFT)
  provider               CommercialBillingProvider    @default(NONE)
  externalCustomerId     String?
  externalSubscriptionId String?
  externalReference      String?
  periodStart            DateTime?
  periodEnd              DateTime?
  renewalAt              DateTime?
  renewalCancellationStatus String?
  renewalCancellationRequestedAt DateTime?
  renewalCancelledAt     DateTime?
  trialStart             DateTime?
  trialEnd               DateTime?
  gracePeriodEndsAt      DateTime?
  basePriceClp           Int?
  professionalTotal      Int
  totalPriceClp          Int?
  termsSnapshot          Json?
  snapshotHash           String
  lastReconciledAt        DateTime?
  lastReconciledEventId   String?
  lastPaymentAt          DateTime?
  lastPaymentEventId     String?
  lastPaymentStatus      String?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt

  business           Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  legacySubscription Subscription?                @relation("LegacyCommercialSubscription", fields: [legacySubscriptionId], references: [id], onDelete: SetNull)
  items              CommercialSubscriptionItem[]
  entitlements       CommercialEntitlement[]
  events             CommercialEvent[]
  seatChangeRequests SeatChangeRequest[]
  billingOperations CommercialBillingOperation[]
  migrationProposals CommercialMigrationProposal[]

  @@unique([id, businessId])
  @@index([status, renewalAt])
  @@index([planCode, status])
  @@index([externalSubscriptionId])
}

model CommercialSubscriptionItem {
  id              String                         @id @default(cuid())
  subscriptionId  String
  kind            CommercialSubscriptionItemKind
  code            String
  description     String?
  quantity        Int
  unitAmountClp   Int?
  amountClp       Int?
  currencyCode    String                         @default("CLP")
  catalogVersion  String
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  pricingSnapshot Json?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  subscription CommercialSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, code, effectiveFrom])
  @@index([subscriptionId, kind, effectiveFrom])
  @@index([subscriptionId, effectiveTo])
}

model CommercialEntitlement {
  id             String                      @id @default(cuid())
  businessId     String
  subscriptionId String
  capability     String
  status         CommercialEntitlementStatus @default(UNKNOWN)
  quantity       Int?
  source         String
  validFrom      DateTime
  validTo        DateTime?
  reason         String?
  metadata       Json?
  dedupeKey      String                      @unique
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  business     Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription CommercialSubscription @relation(fields: [subscriptionId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([businessId, capability, status])
  @@index([subscriptionId, validFrom, validTo])
}

model CommercialEvent {
  id                String                 @id @default(cuid())
  businessId        String
  subscriptionId    String?
  source            String
  eventId           String
  operation         String
  occurredAt        DateTime
  receivedAt        DateTime               @default(now())
  outcome           CommercialEventOutcome @default(RECEIVED)
  providerReference String?
  correlationId     String?
  payloadHash       String?
  details           Json?

  business     Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription CommercialSubscription? @relation(fields: [subscriptionId, businessId], references: [id, businessId], onDelete: NoAction, map: "CommercialEvent_tenant_fkey")
  appliedSeatChange SeatChangeRequest? @relation("AppliedSeatPayment")

  @@unique([source, eventId])
  @@index([businessId, occurredAt])
  @@index([subscriptionId, outcome])
}

model SeatChangeRequest {
  id                           String                  @id @default(cuid())
  businessId                   String
  subscriptionId               String
  kind                         SeatChangeKind
  status                       SeatChangeRequestStatus @default(DRAFT)
  previousProfessionalTotal    Int
  requestedProfessionalTotal   Int
  activeProfessionalsAtRequest Int
  quotedAmountClp              Int
  currencyCode                 String                  @default("CLP")
  catalogVersion               String
  requestedAt                  DateTime                @default(now())
  effectiveAt                  DateTime
  idempotencyKey               String                  @unique
  providerReference            String?
  paymentEvidence              Json?
  quoteSnapshot                Json
  paymentEventId               String?                 @unique
  billingOperation             CommercialBillingOperation?
  paymentEvent                 CommercialEvent?        @relation("AppliedSeatPayment", fields: [paymentEventId], references: [id], onDelete: NoAction)
  conflictReason               String?
  appliedAt                    DateTime?
  cancelledAt                  DateTime?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  business     Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription CommercialSubscription @relation(fields: [subscriptionId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([businessId, status, effectiveAt])
  @@index([subscriptionId, status])
}

// ==========================================
// BUSINESS & SERVICES
// ==========================================

model WebsitePurchaseIntent {
  businessId       String    @id
  selectedAt       DateTime  @default(now())
  baseOperationKey String?   @unique
  baseState        String    @default("NONE")
  baseCheckoutUrl  String?
  baseProviderId   String?
  baseActivatedAt  DateTime?
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Business {
  contactFlowAudits                            CfAudit[]
  contactFlowCampaigns                         CfCampaign[]
  contactFlowPolicies                          CfPolicy[]
  contactFlowConsents                          CfConsent[]
  contactFlowSuppressions                      CfSuppression[]
  mcpPublicDiscovery                           Boolean            @default(false)
  mcpProfiles                                  McpProfile[]
  mcpOperations                                McpOperation[]
  id                                           String             @id @default(cuid())
  name                                         String
  slug                                         String             @unique
  apiKey                                       String             @unique
  logoUrl                                      String?
  address                                      String?
  mapsUrl                                      String?
  primaryColor                                 String             @default("#7C3AED")
  secondaryColor                               String             @default("#5B21B6")
  backgroundColor                              String             @default("#0A0A0A")
  textColor                                    String             @default("#FFFFFF")
  textMutedColor                               String             @default("#FFFFFF66")
  widgetFontSize                               Int                @default(14)
  brandColor                                   String?
  maxServicesPerBooking                        Int                @default(1)
  groupServicesByCategory                      Boolean            @default(false)
  widgetCornerRadius                           Int                @default(16)
  widgetShadowStyle                            String             @default("soft")
  widgetHeaderAlign                            String             @default("left")
  // ── Abono (Deposit) Config ──
  depositRequired                              Boolean            @default(false)
  depositPaymentMode                           DepositPaymentMode @default(MERCADOPAGO)
  allowedOrigins                               String[]           @default([])
  countryCode                                  String             @default("CL")
  currencyCode                                 String             @default("CLP")
  timezone                                     String             @default("America/Santiago")
  locale                                       String             @default("es")
  ownerId                                      String?
  referredByAffiliateId                        String?
  // ── Mercado Pago OAuth (Marketplace) ──
  mpAccessToken                                String?
  mpRefreshToken                               String?
  mpUserId                                     String?
  mpTokenExpiresAt                             DateTime?
  // ── Loyalty / Fidelización ──
  isLoyaltyEnabled                             Boolean            @default(false)
  stampsRequired                               Int                @default(5)
  rewardName                                   String?
  discountType                                 String? // 'PERCENTAGE' | 'FIXED'
  discountValue                                Int?
  loyaltyCodePrefix                            String             @default("PREMIO")
  loyaltyRewardType                            LoyaltyRewardType  @default(PERCENTAGE)
  loyaltyRewardServiceId                       String?
  loyaltyRewardExpirationDays                  Int?
  // ── Politicas del negocio ──
  requiresClientRut                            Boolean            @default(false) // Pedir RUT en el widget
  allowRescheduling                            Boolean            @default(false) // Permitir que clientes reagenden
