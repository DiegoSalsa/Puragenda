      "table": "Business",
      "expression": "(\"currencyCode\" ~ '^[A-Z]{3}$')",
      "source": "20260803223000_business_country_currency"
    },
    "Business_locale_check": {
      "table": "Business",
      "expression": "(\"locale\" IN ('es', 'en', 'it', 'pt', 'fr', 'de', 'zh-CN'))",
      "source": "20260806124500_add_business_locale"
    },
    "StoryCampaign_status_check": {
      "table": "StoryCampaign",
      "expression": "(\"status\" IN ('PUBLISHED', 'ARCHIVED'))",
      "source": "20260808210919_story_studio_growth"
    },
    "StoryCampaign_objective_check": {
      "table": "StoryCampaign",
      "expression": "(\"objective\" IN ('FILL_SLOTS', 'LAST_MINUTE', 'PROMOTE_SERVICE', 'CANCELLATION'))",
      "source": "20260808210919_story_studio_growth"
    },
    "PosPayment_amount_positive": {
      "table": "PosPayment",
      "expression": "(\"amount\" > 0)",
      "source": "20260815160027_add_pos_qr_payments"
    },
    "PosPayment_currency_format": {
      "table": "PosPayment",
      "expression": "(\"currency\" ~ '^[A-Z]{3}$')",
      "source": "20260815160027_add_pos_qr_payments"
    },
    "BookingDiscountCode_code_check": {
      "table": "BookingDiscountCode",
      "expression": "(\"code\" ~ '^[A-Z0-9]([A-Z0-9_-]{0,48}[A-Z0-9])?$')",
      "source": "20260817000000_booking_discount_codes"
    },
    "BookingDiscountCode_value_check": {
      "table": "BookingDiscountCode",
      "expression": "(\n    \"discountValue\" > 0\n    AND (\"discountType\" <> 'PERCENTAGE' OR \"discountValue\" <= 100)\n  )",
      "source": "20260817000000_booking_discount_codes"
    },
    "BookingDiscountCode_minSubtotal_check": {
      "table": "BookingDiscountCode",
      "expression": "(\"minSubtotal\" >= 0)",
      "source": "20260817000000_booking_discount_codes"
    },
    "BookingDiscountCode_dates_check": {
      "table": "BookingDiscountCode",
      "expression": "(\n    \"startsAt\" IS NULL OR \"expiresAt\" IS NULL OR \"startsAt\" < \"expiresAt\"\n  )",
      "source": "20260817000000_booking_discount_codes"
    },
    "TrackingConsent_decision_check": {
      "table": "TrackingConsent",
      "expression": "(\"decision\" IN ('accepted', 'rejected'))",
      "source": "20260829040000_add_privacy_compliance"
    },
    "PrivacyRequest_requestType_check": {
      "table": "PrivacyRequest",
      "expression": "(\"requestType\" IN ('ACCESS', 'RECTIFICATION', 'SUPPRESSION', 'OPPOSITION', 'PORTABILITY', 'BLOCKING'))",
      "source": "20260829040000_add_privacy_compliance"
    },
    "PrivacyRequest_status_check": {
      "table": "PrivacyRequest",
      "expression": "(\"status\" IN ('RECEIVED', 'IN_REVIEW', 'FULFILLED', 'DENIED'))",
      "source": "20260829040000_add_privacy_compliance"
    },
    "PrivacyRequest_identityStatus_check": {
      "table": "PrivacyRequest",
      "expression": "(\"identityStatus\" IN ('PENDING', 'VERIFIED'))",
      "source": "20260829040000_add_privacy_compliance"
    },
    "Business_loyaltyRewardExpirationDays_check": {
      "table": "Business",
      "expression": "(\"loyaltyRewardExpirationDays\" IS NULL OR \"loyaltyRewardExpirationDays\" IN (30, 60, 90))",
      "source": "20260908120000_loyalty_v2"
    },
    "LoyaltyStampEvent_delta_check": {
      "table": "LoyaltyStampEvent",
      "expression": "(\"delta\" <> 0)",
      "source": "20260908120000_loyalty_v2"
    },
    "GiftCardTemplate_salePrice_check": {
      "table": "GiftCardTemplate",
      "expression": "(\"salePrice\" > 0)",
      "source": "20260908213000_add_gift_cards"
    },
    "GiftCardTemplate_faceValue_check": {
      "table": "GiftCardTemplate",
      "expression": "((\"type\" = 'BALANCE' AND \"faceValue\" > 0) OR (\"type\" = 'SERVICE' AND \"faceValue\" IS NULL))",
      "source": "20260908213000_add_gift_cards"
    },
    "GiftCardTemplateService_quantity_check": {
      "table": "GiftCardTemplateService",
      "expression": "(\"quantity\" > 0)",
      "source": "20260908213000_add_gift_cards"
    },
    "GiftCardPurchase_salePrice_check": {
      "table": "GiftCardPurchase",
      "expression": "(\"salePrice\" > 0)",
      "source": "20260908213000_add_gift_cards"
    },
    "GiftCardPurchase_gift_delivery_check": {
      "table": "GiftCardPurchase",
      "expression": "(\n    (\"deliveryMode\" = 'SELF') OR\n    (\"deliveryMode\" = 'GIFT' AND \"recipientName\" IS NOT NULL AND \"recipientEmail\" IS NOT NULL AND \"senderName\" IS NOT NULL)\n  )",
      "source": "20260908213000_add_gift_cards"
    },
    "GiftCard_balance_check": {
      "table": "GiftCard",
      "expression": "(\n    (\"type\" = 'BALANCE' AND \"initialBalance\" >= 0 AND \"remainingBalance\" >= 0 AND \"remainingBalance\" <= \"initialBalance\") OR\n    (\"type\" = 'SERVICE' AND \"initialBalance\" IS NULL AND \"remainingBalance\" IS NULL)\n  )",
      "source": "20260908213000_add_gift_cards"
    },
    "GiftCardServiceEntitlement_quantity_check": {
      "table": "GiftCardServiceEntitlement",
      "expression": "(\"quantityInitial\" > 0 AND \"quantityRemaining\" >= 0 AND \"quantityRemaining\" <= \"quantityInitial\")",
      "source": "20260908213000_add_gift_cards"
    },
    "GiftCardServiceEntitlement_value_check": {
      "table": "GiftCardServiceEntitlement",
      "expression": "(\"unitValueSnapshot\" >= 0)",
      "source": "20260908213000_add_gift_cards"
    },
    "GiftCardRedemption_amount_check": {
      "table": "GiftCardRedemption",
      "expression": "(\"amountCovered\" >= 0)",
      "source": "20260908213000_add_gift_cards"
    },
    "GiftCardRedemptionItem_quantity_check": {
      "table": "GiftCardRedemptionItem",
      "expression": "(\"quantity\" > 0)",
      "source": "20260908213000_add_gift_cards"
    },
    "GiftCardRedemptionItem_amount_check": {
      "table": "GiftCardRedemptionItem",
      "expression": "(\"amountCovered\" >= 0)",
      "source": "20260908213000_add_gift_cards"
    },
    "website_published_snapshot": {
      "table": "BusinessWebsite",
      "expression": "(\"status\" <> 'PUBLISHED' OR (\"publishedConfig\" IS NOT NULL AND \"publishedAt\" IS NOT NULL))",
      "source": "20260930160000_websites_addon_v1"
    },
    "website_subdomain_format": {
      "table": "BusinessWebsite",
      "expression": "(\"subdomain\" ~ '^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$')",
      "source": "20260930160000_websites_addon_v1"
    },
    "website_domain_lowercase": {
      "table": "WebsiteDomain",
      "expression": "(\"hostname\" = lower(\"hostname\"))",
      "source": "20260930160000_websites_addon_v1"
    },
    "WebsitePurchaseIntent_baseState_check": {
      "table": "WebsitePurchaseIntent",
      "expression": "(\"baseState\" IN ('NONE','CREATING','PENDING','UNKNOWN','ACTIVE','CANCELLED'))",
      "source": "20261003220000_website_purchase_intent"
    },
    "Subscription_staffLimitOverride_positive": {
      "table": "Subscription",
      "expression": "(\"staffLimitOverride\" IS NULL OR \"staffLimitOverride\" > 0)",
      "source": "20261017163250_subscription_commercial_terms"
    },
    "Subscription_customMonthlyPriceClp_positive": {
      "table": "Subscription",
      "expression": "(\"customMonthlyPriceClp\" IS NULL OR \"customMonthlyPriceClp\" > 0)",
      "source": "20261017163250_subscription_commercial_terms"
    },
    "Subscription_customMonthlyPriceClp_manual_monthly": {
      "table": "Subscription",
      "expression": "(\"customMonthlyPriceClp\" IS NULL OR (\"paymentMethod\" = 'BANK_TRANSFER' AND \"billingCycle\" = 'MONTHLY'))",
      "source": "20261017163250_subscription_commercial_terms"
    },
    "McpRolloutState_singleton": {
      "table": "McpRolloutState",
      "expression": "(\"id\" = 'global')",
      "source": "20261018055923_mcp_rollout_control"
