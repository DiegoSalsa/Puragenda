# Seguridad base (obligatorias en despliegues)
AUTH_SECRET=
CRON_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
GIFT_CARD_SECRET=

# URLs y correo transaccional (obligatorias en producción)
NEXT_PUBLIC_APP_URL=https://www.puragenda.cl
RESEND_API_KEY=
EMAIL_FROM="Puragenda <notificaciones@puragenda.cl>"

# Base de datos (solo servidor)
DATABASE_URL=
DIRECT_URL=

# Paddle Sandbox (desarrollo y pruebas)
PADDLE_SANDBOX_API_KEY=
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_INDIVIDUAL=
NEXT_PUBLIC_PADDLE_PRICE_EQUIPO=
NEXT_PUBLIC_PADDLE_PRICE_EXTRA_STAFF=
PADDLE_NOTIFICATION_WEBHOOK_SECRET=
WEBSITE_LAUNCH_AT=
# Acquisition and launch announcement are independently disabled by default.
# These flags do not remove paid website runtime entitlement.
WEBSITE_CHECKOUT_ENABLED=0
WEBSITE_LAUNCH_ENABLED=0
WEBSITE_PRICE_STANDARD=
WEBSITE_PRICE_BETA_FOUNDER=

# Product analytics (PostHog is optional; internal superadmin analytics works
# without these values). Project tokens may be public, personal API keys may not.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_SESSION_REPLAY=false
PRIVACY_ADMIN_EMAILS=contacto@purocode.com

# Google Analytics 4 (Measurement ID público). Se carga solo tras consentimiento.
NEXT_PUBLIC_GA_ID=

# Identificación legal pública. Completar con datos reales antes de producción.
PRIVACY_CONTROLLER_NAME=PuroCode / Puragenda
PRIVACY_CONTROLLER_ID=
PRIVACY_POSTAL_ADDRESS=
PRIVACY_REPRESENTATIVE=

# Configura estas dos variables solo en el entorno de produccion, con las
# credenciales, token, precios y secreto de webhook de la cuenta Paddle Live.
# PADDLE_LIVE_API_KEY=
# NEXT_PUBLIC_PADDLE_ENV=production

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Puri (solo servidor)
OPENAI_API_KEY=
# PURI_MODEL=gpt-6-luna
# Optional: JSON map of verified USD prices per million input/output/cachedInput tokens by model.
# PURI_MODEL_PRICES_USD_PER_MILLION=
# Puri+ remains inaccessible in production even when these local flags are set.
PURI_PLUS_INTERNAL_ENABLED=0
PURI_PLUS_AI_ENABLED=0
PURI_PLUS_PROACTIVE_ENABLED=0
# Contact Flow: sending defaults OFF. Production and controlled tests use separate settings.
CONTACT_FLOW_LAB_ENABLED=0
CONTACT_FLOW_TOKEN_SECRET=
CONTACT_FLOW_PUBLIC_ORIGIN=http://127.0.0.1:3119
CONTACT_FLOW_RESEND_WEBHOOK_SECRET=

# Sitios web: todas las credenciales son exclusivas del servidor.
WEBSITE_ROOT_DOMAIN=puragenda.cl
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# La conexión externa permanece deshabilitada hasta su autorización/configuración.
WEBSITE_DOMAIN_PROVIDER=
WEBSITE_VERCEL_WRITES_ENABLED=false
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Solo QA local aislada, jamás producción:
# WEBSITE_QA=1
# WEBSITE_DOMAIN_PROVIDER=mock
# WEBSITE_MEDIA_MOCK=1
# Puragenda MCP / OAuth (server only)
# Disabled by default: hides UI and returns 404 from MCP/OAuth endpoints.
# With true, only the configured reviewers have access until the superadmin
# records OpenAI approval and enables business access in Integrations.
MCP_ENABLED=false
# Review accounts and businesses only, comma-separated immutable IDs.
# Both lists must match; configure only an explicitly authorized test business.
# MCP_REVIEW_USER_IDS=
# MCP_REVIEW_BUSINESS_IDS=
# Suppress email/calendar effects only for MCP writes to the review businesses.
# MCP_REVIEW_SUPPRESS_EFFECTS=true
# MCP_ORIGIN=https://www.puragenda.cl
# MCP_OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
# Allow RFC 8252 loopback /callback[/callback_id] redirects for Codex desktop/CLI:
# MCP_OAUTH_ALLOW_LOOPBACK=true
# Optional additional exact browser origins, comma-separated (no wildcards):
# MCP_ALLOWED_ORIGINS=
# Public booking writes are disabled by default. Enable only for isolated,
# controlled testing until customer identity / anti-abuse verification is ready:
# MCP_PUBLIC_BOOKING_ENABLED=false
# 32 cryptographically random bytes encoded as base64; required for writes:
# MCP_OPERATION_ENCRYPTION_KEY=
# Exact plain-text domain verification challenge from the OpenAI portal:
# OPENAI_APPS_CHALLENGE=
# CRON_SECRET also protects the daily /api/cron/mcp-cleanup job.

# Commercial launch controls (server-only; all closed by default).
COMMERCIAL_V2_PREVIEW_ENABLED=0
COMMERCIAL_V2_PREVIEW_DATABASE_SHA256=
CONTACT_FLOW_PUBLIC_CONSENT_ENABLED=0
COMMERCIAL_WORKER_ENABLED=0
COMMERCIAL_WORKER_KILLED=1
COMMERCIAL_WORKER_SECRET=
COMMERCIAL_WORKER_BUDGET_MS=20000
PURI_PLUS_MAX_OPERATION_MICROS=20000
PURI_PLUS_VERIFIED_PRICING_ENABLED=0
# Exact default model Standard pricing verified 2026-10-22; Plus snapshot expires 2026-11-22.
# Puri standard keeps its existing price map and independent budget behavior.
# A Plus request with missing cache-write/cached-token usage remains UNKNOWN.
CONTACT_FLOW_RESEND_TEST_ENABLED=0
CONTACT_FLOW_RESEND_ISOLATED_ACCOUNT=0
CONTACT_FLOW_RESEND_TEST_BUSINESS_ID=
CONTACT_FLOW_RESEND_TEST_RECIPIENTS=[]
CONTACT_FLOW_RESEND_FROM=
CONTACT_FLOW_RESEND_DOMAIN_ID=
CONTACT_FLOW_RESEND_API_KEY=
# Domain-restricted sending keys cannot read domain status or delivery receipts.
# Optional server-only read credential; never used to send email.
CONTACT_FLOW_RESEND_READ_API_KEY=
# Lab-only alternative to account isolation: <=3 named messages, <=3 recipients,
# <=2 hours, bound database/policy/credential; never valid for production.
CONTACT_FLOW_RESEND_CERTIFICATION_JSON=
# Production release requires verified permanent endpoints and an explicit approval.
# Never reuse test or transactional sending credentials.
CONTACT_FLOW_DELIVERY_MODE=simulation
CONTACT_FLOW_PRODUCTION_RESEND_API_KEY=
CONTACT_FLOW_PRODUCTION_RESEND_READ_API_KEY=
CONTACT_FLOW_PRODUCTION_ENABLED=0
CONTACT_FLOW_EXTERNAL_RELEASE=false
# Shared Free is approved for launch. Increase capacity manually; never purchase automatically.
CONTACT_FLOW_PROVIDER_CAPACITY_MODE=shared_free
CONTACT_FLOW_TRANSACTIONAL_DAILY_RESERVE=40
CONTACT_FLOW_TRANSACTIONAL_MONTHLY_RESERVE=1000
CONTACT_FLOW_RESEND_POLL_SECONDS=30
CONTACT_FLOW_RESEND_MAX_AGE_SECONDS=60
CONTACT_FLOW_PRODUCTION_RESEND_WEBHOOK_SECRET=
CONTACT_FLOW_PRODUCTION_PREVIOUS_WEBHOOK_SECRET=
CONTACT_FLOW_PRODUCTION_DOMAIN_ID=
CONTACT_FLOW_PRODUCTION_FROM=contacto@contacto.puragenda.cl
CONTACT_FLOW_PRODUCTION_REPLY_TO=contacto@purocode.com
CONTACT_FLOW_PRODUCTION_WEBHOOK_ID=
# Server-only v2 approval binds eligible Plus access, credential/policy hashes,
# sender, attended Reply-To, domain, webhook and official HTTPS origin.
# Generate with scripts/prepare-contact-flow-production.ts after endpoint verification.
CONTACT_FLOW_PRODUCTION_APPROVAL_JSON=

# Chile V2 owner checkout: synthetic businesses and sandbox only.
COMMERCIAL_V2_INTERNAL_WRITES=0
COMMERCIAL_V2_SANDBOX_WRITES=0
COMMERCIAL_V2_SANDBOX_WEBHOOKS=0
COMMERCIAL_V2_PROVIDER_ENV=sandbox
COMMERCIAL_V2_MP_OWNER_SANDBOX=0
COMMERCIAL_V2_MP_ACCESS_TOKEN=
COMMERCIAL_V2_MP_WEBHOOK_SECRET=
COMMERCIAL_V2_MP_TEST_ACCOUNT_ID=
COMMERCIAL_V2_MP_TEST_PAYER_EMAIL=
COMMERCIAL_V2_CHECKOUT_RETURN_URL=http://127.0.0.1:3000/dashboard/puri-plus
# Existing mid-cycle / plan-change policies remain unverified externally.
COMMERCIAL_V2_MP_RENEWAL_VALIDATED=0

# Unified Next release (enable with the joint release; providers retain their own seals)
PURAGENDA_NEXT_ENABLED=0
# Central versioned allowances, no implicit commercial defaults. Validate with commercialUsagePolicySchema.
# Keys: version, trial.{PURAGENDA,PURAGENDA_PLUS}, paid.{PURAGENDA,PURAGENDA_PLUS}, global.
# Allocations: puri.{ALL,STANDARD_INTERACTIVE,PLUS_INTERACTIVE,RECOMMENDATION,ANALYSIS_SQL,PROACTIVE_SQL}.{limitMicros,limitUnits}; marketing.{maxEmails,maxCampaignsPerMonth}; contactFlow.{dailyLimit,monthlyLimit,trialLimit,campaignsPerPeriod,maxContactsPerCampaign,contactDays,senderEmail,emailEnabled,killed}.
COMMERCIAL_USAGE_POLICY_JSON=
# V2 billing is separate from legacy Mercado Pago and disposable commercial labs.
# Keep disabled until sandbox checkout, signed webhooks and renewals are validated.
PURAGENDA_MP_V2_ENABLED=0
PURAGENDA_MP_V2_ENVIRONMENT=sandbox
PURAGENDA_MP_V2_APP_URL=http://127.0.0.1:3012
PURAGENDA_MP_V2_SANDBOX_ACCESS_TOKEN=
PURAGENDA_MP_V2_SANDBOX_WEBHOOK_SECRET=
PURAGENDA_MP_V2_SANDBOX_ACCOUNT_ID=
PURAGENDA_MP_V2_SANDBOX_APPLICATION_ID=
# Only for official test-user credentials whose API responses use live_mode=true.
# Pinned to test seller 3468148589 / application 1712173371015642, MLC + test_user.
PURAGENDA_MP_V2_SANDBOX_ACCOUNT_LIVE_MODE=0
# Finite V2 recovery through the single commercial worker. Production requires
# every native production guard plus the explicit additional switch below.
PURAGENDA_MP_V2_RECOVERY_ENABLED=0
PURAGENDA_MP_V2_PRODUCTION_RECOVERY_ENABLED=0
# Required only for a deliberately isolated non-local test database.
PURAGENDA_MP_V2_SANDBOX_DATABASE_SHA256=
PURAGENDA_MP_V2_PRODUCTION_WRITES=0
PURAGENDA_MP_V2_PRODUCTION_ACCESS_TOKEN=
PURAGENDA_MP_V2_PRODUCTION_WEBHOOK_SECRET=
PURAGENDA_MP_V2_PRODUCTION_ACCOUNT_ID=
PURAGENDA_MP_V2_PRODUCTION_APPLICATION_ID=
