# Seguridad base (obligatorias en despliegues)
AUTH_SECRET=
CRON_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=

# Base de datos (solo servidor)
DATABASE_URL=
DIRECT_URL=

# Paddle Sandbox (desarrollo y pruebas)
PADDLE_SANDBOX_API_KEY=
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_INDIVIDUAL=
NEXT_PUBLIC_PADDLE_PRICE_EQUIPO=
NEXT_PUBLIC_PADDLE_PRICE_EXTRA_STAFF=
PADDLE_NOTIFICATION_WEBHOOK_SECRET=

# Configura estas dos variables solo en el entorno de produccion, con las
# credenciales, token, precios y secreto de webhook de la cuenta Paddle Live.
# PADDLE_LIVE_API_KEY=
# NEXT_PUBLIC_PADDLE_ENV=production

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Google Wallet (pases de fidelizaciÃ³n)
# Crea una cuenta de emisor y una service account con acceso a Google Wallet API.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_SERVICE_ACCOUNT_PRIVATE_KEY=

# Apple Wallet (pases de fidelizaciÃ³n)
# Certificados PEM codificados en base64. Nunca los subas al repositorio.
APPLE_WALLET_PASS_TYPE_IDENTIFIER=
APPLE_WALLET_TEAM_IDENTIFIER=
APPLE_WALLET_SIGNER_CERT_BASE64=
APPLE_WALLET_SIGNER_KEY_BASE64=
APPLE_WALLET_WWDR_CERT_BASE64=
# APPLE_WALLET_SIGNER_KEY_PASSPHRASE=
