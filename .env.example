# Seguridad base (obligatorias en despliegues)
AUTH_SECRET=
CRON_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
GIFT_CARD_SECRET=

# URLs y correo transaccional (obligatorias en producción)
NEXT_PUBLIC_APP_URL=https://www.puragenda.cl
RESEND_API_KEY=
EMAIL_FROM="Puragenda <notificaciones@puragenda.cl>"

# Base de datos (solo servidor)
DATABASE_URL=
DIRECT_URL=

# Paddle Sandbox (desarrollo y pruebas)
PADDLE_SANDBOX_API_KEY=
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_INDIVIDUAL=
NEXT_PUBLIC_PADDLE_PRICE_EQUIPO=
NEXT_PUBLIC_PADDLE_PRICE_EXTRA_STAFF=
PADDLE_NOTIFICATION_WEBHOOK_SECRET=
WEBSITE_LAUNCH_AT=
# Acquisition and launch announcement are independently disabled by default.
# These flags do not remove paid website runtime entitlement.
WEBSITE_CHECKOUT_ENABLED=0
WEBSITE_LAUNCH_ENABLED=0
WEBSITE_PRICE_STANDARD=
WEBSITE_PRICE_BETA_FOUNDER=

# Product analytics (PostHog is optional; internal superadmin analytics works
# without these values). Project tokens may be public, personal API keys may not.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_SESSION_REPLAY=false
PRIVACY_ADMIN_EMAILS=contacto@purocode.com

# Google Analytics 4 (Measurement ID público). Se carga solo tras consentimiento.
NEXT_PUBLIC_GA_ID=

# Identificación legal pública. Completar con datos reales antes de producción.
PRIVACY_CONTROLLER_NAME=PuroCode / Puragenda
PRIVACY_CONTROLLER_ID=
PRIVACY_POSTAL_ADDRESS=
PRIVACY_REPRESENTATIVE=

# Configura estas dos variables solo en el entorno de produccion, con las
# credenciales, token, precios y secreto de webhook de la cuenta Paddle Live.
# PADDLE_LIVE_API_KEY=
# NEXT_PUBLIC_PADDLE_ENV=production

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Puri (solo servidor)
OPENAI_API_KEY=
# PURI_MODEL=gpt-6-luna
# Optional: JSON map of verified USD prices per million input/output/cachedInput tokens by model.
# PURI_MODEL_PRICES_USD_PER_MILLION=

# Sitios web: todas las credenciales son exclusivas del servidor.
WEBSITE_ROOT_DOMAIN=puragenda.cl
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# La conexión externa permanece deshabilitada hasta su autorización/configuración.
WEBSITE_DOMAIN_PROVIDER=
WEBSITE_VERCEL_WRITES_ENABLED=false
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Solo QA local aislada, jamás producción:
# WEBSITE_QA=1
# WEBSITE_DOMAIN_PROVIDER=mock
# WEBSITE_MEDIA_MOCK=1
